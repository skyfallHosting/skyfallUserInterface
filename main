    contentSubtitle.TextXAlignment = Enum.TextXAlignment.Left
    contentSubtitle.ZIndex = 7

    local contentTabPill = Instance.new("TextLabel")
    contentTabPill.Name = "contentTabPill"
    contentTabPill.Parent = contentHeader
    contentTabPill.BackgroundColor3 = Color3.fromRGB(29, 24, 43)
    contentTabPill.BackgroundTransparency = 0.10
    contentTabPill.Position = UDim2.new(1, -92, 0, 18)
    contentTabPill.Size = UDim2.new(0, 74, 0, 24)
    contentTabPill.Font = Enum.Font.GothamSemibold
    contentTabPill.Text = "PLAY"
    contentTabPill.TextColor3 = library.accentColor
    contentTabPill.TextSize = 9
    contentTabPill.ZIndex = 7
    local contentTabCorner = Instance.new("UICorner")
