    contentSubtitle.BackgroundTransparency = 1
    contentSubtitle.Position = UDim2.new(0, 18, 0, 34)
    contentSubtitle.Size = UDim2.new(1, -138, 0, 17)
    contentSubtitle.Font = Enum.Font.Gotham
