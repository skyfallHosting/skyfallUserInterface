        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(18, 19, 27)),
        ColorSequenceKeypoint.new(0.55, Color3.fromRGB(13, 14, 20)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(11, 12, 18))
    }
    containerGradient.Rotation = 100
    containerGradient.Name = "containerGradient"
    containerGradient.Parent = container

    -- Content header gives every tab a stronger visual hierarchy.
    local contentHeader = Instance.new("Frame")
