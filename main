        local btnY = btn.AbsolutePosition.Y - tabButtonsEdge.AbsolutePosition.Y
        TweenService:Create(tabIndicator, TweenTable["tab_indicator"], {Position = UDim2.new(0, 1, 0, btnY + 3)}):Play()
