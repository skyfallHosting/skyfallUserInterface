function library:GetDay(type)
    if type == "word" then -- day in a full word
        return os.date("%A")
    elseif type == "short" then -- day in a shortened word
        return os.date("%a")
    elseif type == "month" then -- day of the month in digits
        return os.date("%d")
    elseif type == "year" then -- day of the year in digits
        return os.date("%j")
    end
end

function library:GetTime(type)
    if type == "24h" then -- time using a 24 hour clock
        return os.date("%H")
    elseif type == "12h" then -- time using a 12 hour clock
        return os.date("%I")
    elseif type == "minute" then -- time in minutes
        return os.date("%M")
    elseif type == "half" then -- what part of the day it is (AM or PM)
        return os.date("%p")
    elseif type == "second" then -- time in seconds
        return os.date("%S")
    elseif type == "full" then -- full time
        return os.date("%X")
    elseif type == "ISO" then -- ISO / UTC ( 1min = 1, 1hour = 100)
        return os.date("%z")
    elseif type == "zone" then -- time zone
        return os.date("%Z") 
    end
end

function library:GetMonth(type)
    if type == "word" then -- full month name
        return os.date("%B")
    elseif type == "short" then -- month in shortened word
        return os.date("%b")
    elseif type == "digit" then -- the months digit
        return os.date("%m")
    end
end

function library:GetWeek(type)
    if type == "year_S" then -- the number of the week in the current year (sunday first day)
        return os.date("%U")
    elseif type == "day" then -- the week day
        return os.date("%w")
    elseif type == "year_M" then -- the number of the week in the current year (monday first day)
        return os.date("%W")
    end
end

function library:GetYear(type)
    if type == "digits" then -- the second 2 digits of the year
        return os.date("%y")
    elseif type == "full" then -- the full year
        return os.date("%Y")
    end
end

function library:UnlockFps(new) -- syn only
    if syn then
        setfpscap(new)
    end
end

function library:LoadIcon(url, filename)
    local asset = ""
    pcall(function()
        if typeof(getcustomasset) == "function" then
            if not isfile(filename) then writefile(filename, game:HttpGet(url)) end
            asset = getcustomasset(filename)
        elseif typeof(getsynasset) == "function" then
            if not isfile(filename) then writefile(filename, game:HttpGet(url)) end
            asset = getsynasset(filename)
        end
    end)
    return asset ~= "" and asset or nil
end

-- / Skyfall atmosphere assets
-- Soft lighting textures are embedded so the ambience works without extra repository files.
local _b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function _decodeBase64(data)
    data = string.gsub(data, "[^" .. _b64chars .. "=]", "")
    return (data:gsub(".", function(x)
        if x == "=" then return "" end
        local r = ""
        local f = (_b64chars:find(x, 1, true) or 1) - 1
        for i = 6, 1, -1 do
            r = r .. ((f % 2^i - f % 2^(i - 1) > 0) and "1" or "0")
        end
        return r
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
        if #x ~= 8 then return "" end
        local c = 0
        for i = 1, 8 do
            if x:sub(i, i) == "1" then
                c = c + 2^(8 - i)
            end
        end
        return string.char(c)
    end))
end

local _SKYFALL_GLOW_B64 = [[]]
local _SKYFALL_NOISE_B64 = [[]]

function library:LoadEmbeddedAsset(filename, encoded)
    local asset = nil
    pcall(function()
        if typeof(writefile) ~= "function" then return end
        if typeof(isfile) ~= "function" or not isfile(filename) then
            writefile(filename, _decodeBase64(encoded))
        end
        if typeof(getcustomasset) == "function" then
            asset = getcustomasset(filename)
        elseif typeof(getsynasset) == "function" then
            asset = getsynasset(filename)
        end
    end)
    return asset
end

function library:InitAtmosphereAssets()
    if not self.glowAsset then
        self.glowAsset = self:LoadEmbeddedAsset("skyfall_ui_soft_glow.png", _SKYFALL_GLOW_B64)
    end
    if not self.noiseAsset then
        self.noiseAsset = self:LoadEmbeddedAsset("skyfall_ui_grain.png", _SKYFALL_NOISE_B64)
    end
end

-- Lucide icon names/geometry come from the Lucide catalogue and are cached locally.
-- PNG is preferred for executor compatibility; official Lucide SVGs remain the fallback.
function library:LoadLucideIcon(name)
    name = tostring(name or ""):lower():gsub("[^%w%-]", "")
    if name == "" then return nil end
    if self._lucideIcons[name] ~= nil then
        return self._lucideIcons[name] or nil
    end

    -- Roblox custom assets are much more reliable with PNG than SVG.
    -- Iconify mirrors the Lucide catalogue; weserv rasterizes the white SVG to PNG,
    -- preserving Lucide's exact geometry while allowing ImageColor3 tinting.
    local encodedIconify =
        "https%3A%2F%2Fapi.iconify.design%2Flucide%2F" .. name ..
        ".svg%3Fcolor%3Dwhite%26width%3D48%26height%3D48"
    local pngUrl =
        "https://images.weserv.nl/?url=" .. encodedIconify ..
        "&output=png&w=48&h=48&fit=contain"

    local asset = self:LoadIcon(pngUrl, "skyfall_lucide_" .. name .. ".png")
    if not asset then
        -- Fallback for executors that happen to support SVG custom assets directly.
        asset = self:LoadIcon(
            "https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/" .. name .. ".svg",
            "skyfall_lucide_" .. name .. ".svg"
        )
    end

    self._lucideIcons[name] = asset or false
    return asset
end

function library:LucideForTab(titleText)
    local key = tostring(titleText or ""):lower()
    if key:find("play", 1, true) then return "play" end
    if key:find("visual", 1, true) then return "eye" end
    if key:find("webhook", 1, true) then return "webhook" end
    if key:find("info", 1, true) then return "circle-help" end
    if key:find("setting", 1, true) then return "settings" end
    if key:find("config", 1, true) then return "folder-cog" end
    if key:find("player", 1, true) then return "user-round" end
    return "circle"
end

function library:LucideForSection(titleText)
    local key = tostring(titleText or ""):lower()
    if key:find("dungeon", 1, true) then return "castle" end
    if key:find("lobby", 1, true) then return "shield" end
    if key:find("automat", 1, true) then return "refresh-cw" end
    if key:find("loadout", 1, true) or key:find("weapon", 1, true) then return "swords" end
    if key:find("visual", 1, true) then return "eye" end
    if key:find("movement", 1, true) then return "move" end
    if key:find("teleport", 1, true) then return "map-pin" end
    if key:find("player", 1, true) then return "user-round" end
    if key:find("farm", 1, true) then return "sprout" end
    if key:find("setting", 1, true) then return "sliders-horizontal" end
    if key:find("config", 1, true) then return "folder-cog" end
    return "sparkles"
end

function library:TabSubtitle(titleText)
    local key = tostring(titleText or ""):lower()
    if key:find("play", 1, true) then return "Automation & gameplay controls" end
    if key:find("visual", 1, true) then return "ESP & visual presentation" end
    if key:find("webhook", 1, true) then return "External notifications & integrations" end
    if key:find("info", 1, true) then return "Session & build information" end
    if key:find("setting", 1, true) then return "Interface & behavior preferences" end
    if key:find("config", 1, true) then return "Save & restore your profiles" end
    return "Skyfall controls"
end

function library:AddSoftGlow(parent, transparency, padding, color, zIndex)
    if not self.glowAsset or not parent then return nil end
    local glow = Instance.new("ImageLabel")
    glow.Name = "softGlow"
    glow.Parent = parent
    glow.BackgroundTransparency = 1
    glow.Image = self.glowAsset
    glow.ImageColor3 = color or self.accentColor
    glow.ImageTransparency = transparency or 0.9
    glow.ScaleType = Enum.ScaleType.Slice
    glow.SliceCenter = Rect.new(40, 40, 88, 88)
    glow.Position = UDim2.new(0, -(padding or 12), 0, -(padding or 12))
    glow.Size = UDim2.new(1, (padding or 12) * 2, 1, (padding or 12) * 2)
    glow.ZIndex = math.max(zIndex or 1, 1)
    glow.Active = false
    glow.Selectable = false
    return glow
end

function library:AddNoise(parent, transparency)
    if not self.noiseAsset or not parent then return nil end
    local grain = Instance.new("ImageLabel")
    grain.Name = "ambientGrain"
    grain.Parent = parent
    grain.BackgroundTransparency = 1
    grain.Image = self.noiseAsset
    grain.ImageColor3 = Color3.fromRGB(180, 180, 200)
    grain.ImageTransparency = transparency or 0.965
    grain.ScaleType = Enum.ScaleType.Tile
    grain.TileSize = UDim2.new(0, 96, 0, 96)
    grain.Size = UDim2.new(1, 0, 1, 0)
    grain.ZIndex = 3
    grain.Active = false
    grain.Selectable = false
    return grain
end

function library:SetAccentColor(newColor)
    local oldColor = library.accentColor
    library.accentColor = newColor
    library.accentSoft = newColor:Lerp(Color3.fromRGB(105, 105, 125), 0.24)
    local dark67 = accentDark(0.67)
    local dark81 = accentDark(0.81)

    local oldDark67 = Color3.new(math.clamp(oldColor.R * 0.67, 0, 1), math.clamp(oldColor.G * 0.67, 0, 1), math.clamp(oldColor.B * 0.67, 0, 1))
    local oldDark81 = Color3.new(math.clamp(oldColor.R * 0.81, 0, 1), math.clamp(oldColor.G * 0.81, 0, 1), math.clamp(oldColor.B * 0.81, 0, 1))
    local _, _, oldBrightness = Color3.toHSV(oldColor)
    local doFuzzyMatch = oldBrightness > 0.2

    local function colorsClose(c1, c2, threshold)
        return math.abs(c1.R - c2.R) < threshold
           and math.abs(c1.G - c2.G) < threshold
           and math.abs(c1.B - c2.B) < threshold
    end

    for _, gui in ipairs(library._screenGuis) do
        pcall(function()
            if not gui or not gui.Parent then return end
            for _, desc in ipairs(gui:GetDescendants()) do
                pcall(function()
                    if desc:IsA("GuiObject") and desc.BackgroundColor3 == oldColor then
                        desc.BackgroundColor3 = newColor
                    end
                    if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.TextColor3 == oldColor then
                        desc.TextColor3 = newColor
                    end
                    if desc:IsA("ImageLabel") and desc.ImageColor3 == oldColor then
                        desc.ImageColor3 = newColor
                    end
                    if desc:IsA("UIStroke") and desc.Color == oldColor then
                        desc.Color = newColor
                    end
                    if desc:IsA("ScrollingFrame") and desc.ScrollBarImageColor3 == oldColor then
                        desc.ScrollBarImageColor3 = newColor
                    end
                    if desc:IsA("UIGradient") then
                        local kps = desc.Color.Keypoints
                        local changed = false
                        local newKps = {}
                        for _, kp in ipairs(kps) do
                            local v = kp.Value
                            if v == oldColor then
                                table.insert(newKps, ColorSequenceKeypoint.new(kp.Time, newColor))
                                changed = true
                            elseif doFuzzyMatch and colorsClose(v, oldDark67, 0.02) then
                                table.insert(newKps, ColorSequenceKeypoint.new(kp.Time, dark67))
                                changed = true
                            elseif doFuzzyMatch and colorsClose(v, oldDark81, 0.02) then
                                table.insert(newKps, ColorSequenceKeypoint.new(kp.Time, dark81))
                                changed = true
                            else
                                table.insert(newKps, kp)
                            end
                        end
                        if changed then
                            desc.Color = ColorSequence.new(newKps)
                        end
                    end
                end)
            end
        end)
    end
end

function library:ApplyTheme()
    local top = self.accentColor
    local bot = self.gradientEnabled and self.accentColorBottom or top
    local bg = self.bgColor
    local bgMid = Color3.new(
        math.clamp(bg.R * 0.90, 0, 1),
        math.clamp(bg.G * 0.90, 0, 1),
        math.clamp(bg.B * 0.90, 0, 1)
    )
    local bgDark = Color3.new(
        math.clamp(bg.R * 0.74, 0, 1),
        math.clamp(bg.G * 0.74, 0, 1),
        math.clamp(bg.B * 0.74, 0, 1)
    )

    for _, gui in ipairs(self._screenGuis) do
        pcall(function()
            if not gui or not gui.Parent then return end
            for _, desc in ipairs(gui:GetDescendants()) do
                pcall(function()
                    if desc.Name == "tabIndicator" and desc:IsA("Frame") then
                        desc.BackgroundColor3 = top
                    elseif desc.Name == "bar" and desc:IsA("Frame") and desc.Parent and desc.Parent.Name == "barFolder" then
                        desc.BackgroundColor3 = top
                    elseif desc.Name == "headerBarGradient" and desc:IsA("UIGradient") then
                        desc.Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0.00, accentDark(0.42)),
                            ColorSequenceKeypoint.new(0.26, top),
                            ColorSequenceKeypoint.new(0.72, bot),
                            ColorSequenceKeypoint.new(1.00, accentDark(0.36))
                        }
                    elseif desc.Name == "sliderIndicatorGradient" and desc:IsA("UIGradient") then
                        desc.Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0, top),
                            ColorSequenceKeypoint.new(1, bot)
                        }
                    elseif desc.Name == "toggleGradient" and desc:IsA("UIGradient") then
                        local track = desc.Parent
                        local isOn = track and track:IsA("Frame") and track.BackgroundColor3 == top
                        desc.Color = isOn and ColorSequence.new{
                            ColorSequenceKeypoint.new(0, top),
                            ColorSequenceKeypoint.new(1, bot)
                        } or ColorSequence.new{
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(53, 54, 68)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(38, 39, 51))
                        }
                    elseif desc.Name == "statusDot" and desc:IsA("Frame") then
                        desc.BackgroundColor3 = top
                    elseif desc.Name == "softGlow" and desc:IsA("ImageLabel") then
                        desc.ImageColor3 = top
                    elseif desc.Name == "gbLucideIcon" and desc:IsA("ImageLabel") then
                        desc.ImageColor3 = top
                    elseif desc.Name == "backgroundGradient" and desc:IsA("UIGradient") then
                        desc.Color = self.gradientEnabled and ColorSequence.new{
                            ColorSequenceKeypoint.new(0, bg),
                            ColorSequenceKeypoint.new(0.50, bgMid),
                            ColorSequenceKeypoint.new(1, bgDark)
                        } or ColorSequence.new{ColorSequenceKeypoint.new(0, bg), ColorSequenceKeypoint.new(1, bg)}
                    elseif desc.Name == "containerGradient" and desc:IsA("UIGradient") then
                        desc.Color = self.gradientEnabled and ColorSequence.new{
                            ColorSequenceKeypoint.new(0, bgMid),
                            ColorSequenceKeypoint.new(0.55, bg),
                            ColorSequenceKeypoint.new(1, bgDark)
                        } or ColorSequence.new{ColorSequenceKeypoint.new(0, bg), ColorSequenceKeypoint.new(1, bg)}
                    elseif (desc.Name == "tabButtonsGradient" or desc.Name == "sidebarShellGradient") and desc:IsA("UIGradient") then
                        -- Inner navigation panel and outer sidebar shell intentionally share
                        -- the exact same background behavior.
                        desc.Color = self.gradientEnabled and ColorSequence.new{
                            ColorSequenceKeypoint.new(0, bgMid),
                            ColorSequenceKeypoint.new(1, bgDark)
                        } or ColorSequence.new{ColorSequenceKeypoint.new(0, bg), ColorSequenceKeypoint.new(1, bg)}
                    elseif desc.Name == "sidebarShellStroke" and desc:IsA("UIStroke") then
                        -- Keep definition via a subtle line instead of a different fill color.
                        desc.Color = self.strokeSoftColor
                    elseif desc.Name == "groupboxAmbientStroke" and desc:IsA("UIStroke") then
                        desc.Color = self.accentSoft
                    elseif desc.Name == "windowAccentStroke" and desc:IsA("UIStroke") then
                        desc.Color = top
                    elseif desc.Name == "windowGlowStroke" and desc:IsA("UIStroke") then
                        desc.Color = top
                    end

                    if desc:IsA("ScrollingFrame") then
                        desc.ScrollBarImageColor3 = accentDark(0.72)
                    end
                end)
            end
        end)
    end
end


function library:Watermark(text)
    for i,v in pairs(CoreGuiService:GetChildren()) do
        if v.Name == "watermark" then
            v:Destroy()
        end
    end

    tetx = text or "xsx v2"

    local watermark = Instance.new("ScreenGui")
    local watermarkPadding = Instance.new("UIPadding")
    local watermarkLayout = Instance.new("UIListLayout")
    local edge = Instance.new("Frame")
    local edgeCorner = Instance.new("UICorner")
    local background = Instance.new("Frame")
    local barFolder = Instance.new("Folder")
    local bar = Instance.new("Frame")
    local barCorner = Instance.new("UICorner")
    local barLayout = Instance.new("UIListLayout")
    local backgroundGradient = Instance.new("UIGradient")
    local backgroundCorner = Instance.new("UICorner")
    local waterText = Instance.new("TextLabel")
    local waterPadding = Instance.new("UIPadding")
    local backgroundLayout = Instance.new("UIListLayout")

    watermark.Name = "watermark"
    watermark.Parent = CoreGuiService
    watermark.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    watermark.DisplayOrder = 999
    table.insert(library._screenGuis, watermark)
    
    watermarkLayout.Name = "watermarkLayout"
    watermarkLayout.Parent = watermark
    watermarkLayout.FillDirection = Enum.FillDirection.Horizontal
    watermarkLayout.SortOrder = Enum.SortOrder.LayoutOrder
    watermarkLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    watermarkLayout.Padding = UDim.new(0, 4)
    
    watermarkPadding.Name = "watermarkPadding"
    watermarkPadding.Parent = watermark
    watermarkPadding.PaddingBottom = UDim.new(0, 6)
    watermarkPadding.PaddingLeft = UDim.new(0, 6)

    edge.Name = "edge"
    edge.Parent = watermark
    edge.AnchorPoint = Vector2.new(0.5, 0.5)
    edge.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    edge.Position = UDim2.new(0.5, 0, -0.03, 0)
    edge.Size = UDim2.new(0, 0, 0, 26)
    edge.BackgroundTransparency = 1

    edgeCorner.CornerRadius = UDim.new(0, 2)
    edgeCorner.Name = "edgeCorner"
    edgeCorner.Parent = edge

    background.Name = "background"
    background.Parent = edge
    background.AnchorPoint = Vector2.new(0.5, 0.5)
    background.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    background.BackgroundTransparency = 1
    background.ClipsDescendants = true
    background.Position = UDim2.new(0.5, 0, 0.5, 0)
    background.Size = UDim2.new(0, 0, 0, 24)

    barFolder.Name = "barFolder"
    barFolder.Parent = background

    bar.Name = "bar"
    bar.Parent = barFolder
    bar.BackgroundColor3 = library.accentColor
    bar.BackgroundTransparency = 0
    bar.Size = UDim2.new(0, 0, 0, 1)

    barCorner.CornerRadius = UDim.new(0, 2)
    barCorner.Name = "barCorner"
    barCorner.Parent = bar

    barLayout.Name = "barLayout"
    barLayout.Parent = barFolder
    barLayout.SortOrder = Enum.SortOrder.LayoutOrder

    backgroundGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(34, 34, 34)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(28, 28, 28))}
    backgroundGradient.Rotation = 90
    backgroundGradient.Name = "backgroundGradient"
    backgroundGradient.Parent = background

    backgroundCorner.CornerRadius = UDim.new(0, 2)
    backgroundCorner.Name = "backgroundCorner"
    backgroundCorner.Parent = background

    waterText.Name = "notifText"
    waterText.Parent = background
    waterText.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    waterText.BackgroundTransparency = 1.000
    waterText.Position = UDim2.new(0, 0, -0.0416666679, 0)
    waterText.Size = UDim2.new(0, 0, 0, 24)
    waterText.Font = Enum.Font.Code
    waterText.Text = text
    waterText.TextColor3 = Color3.fromRGB(198, 198, 198)
    waterText.TextTransparency = 1
    waterText.TextSize = 14.000
    waterText.RichText = true

    local NewSize = TextService:GetTextSize(waterText.Text, waterText.TextSize, waterText.Font, Vector2.new(math.huge, math.huge))
    waterText.Size = UDim2.new(0, NewSize.X + 8, 0, 24)

    waterPadding.Name = "notifPadding"
    waterPadding.Parent = waterText
    waterPadding.PaddingBottom = UDim.new(0, 4)
    waterPadding.PaddingLeft = UDim.new(0, 4)
    waterPadding.PaddingRight = UDim.new(0, 4)
    waterPadding.PaddingTop = UDim.new(0, 4)

    backgroundLayout.Name = "backgroundLayout"
    backgroundLayout.Parent = background
    backgroundLayout.SortOrder = Enum.SortOrder.LayoutOrder
    backgroundLayout.VerticalAlignment = Enum.VerticalAlignment.Center

    local totalW = NewSize.x + 8

    CreateTween("wm", 0.24)
    CreateTween("wm_2", 0.04)
    coroutine.wrap(function()
        TweenService:Create(edge, TweenTable["wm"], {BackgroundTransparency = 0}):Play()
        TweenService:Create(edge, TweenTable["wm"], {Size = UDim2.new(0, totalW + 2, 0, 26)}):Play()
        TweenService:Create(background, TweenTable["wm"], {BackgroundTransparency = 0}):Play()
        TweenService:Create(background, TweenTable["wm"], {Size = UDim2.new(0, totalW, 0, 24)}):Play()
        wait(.2)
        TweenService:Create(bar, TweenTable["wm"], {Size = UDim2.new(0, totalW, 0, 1)}):Play()
        wait(.1)
        TweenService:Create(waterText, TweenTable["wm"], {TextTransparency = 0}):Play()
    end)()

    local WatermarkFunctions = {}
    function WatermarkFunctions:AddWatermark(text)
        tetx = text or "xsx v2"

        local edge = Instance.new("Frame")
        local edgeCorner = Instance.new("UICorner")
        local background = Instance.new("Frame")
        local barFolder = Instance.new("Folder")
        local bar = Instance.new("Frame")
        local barCorner = Instance.new("UICorner")
        local barLayout = Instance.new("UIListLayout")
        local backgroundGradient = Instance.new("UIGradient")
        local backgroundCorner = Instance.new("UICorner")
        local waterText = Instance.new("TextLabel")
        local waterPadding = Instance.new("UIPadding")
        local backgroundLayout = Instance.new("UIListLayout")
    
        edge.Name = "edge"
        edge.Parent = watermark
        edge.AnchorPoint = Vector2.new(0.5, 0.5)
        edge.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        edge.Position = UDim2.new(0.5, 0, -0.03, 0)
        edge.Size = UDim2.new(0, 0, 0, 26)
        edge.BackgroundTransparency = 1
    
        edgeCorner.CornerRadius = UDim.new(0, 2)
        edgeCorner.Name = "edgeCorner"
        edgeCorner.Parent = edge
    
        background.Name = "background"
        background.Parent = edge
        background.AnchorPoint = Vector2.new(0.5, 0.5)
        background.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        background.BackgroundTransparency = 1
        background.ClipsDescendants = true
        background.Position = UDim2.new(0.5, 0, 0.5, 0)
        background.Size = UDim2.new(0, 0, 0, 24)
    
        barFolder.Name = "barFolder"
        barFolder.Parent = background
    
        bar.Name = "bar"
        bar.Parent = barFolder
        bar.BackgroundColor3 = library.accentColor
        bar.BackgroundTransparency = 0
        bar.Size = UDim2.new(0, 0, 0, 1)
    
        barCorner.CornerRadius = UDim.new(0, 2)
        barCorner.Name = "barCorner"
        barCorner.Parent = bar
    
        barLayout.Name = "barLayout"
        barLayout.Parent = barFolder
        barLayout.SortOrder = Enum.SortOrder.LayoutOrder
    
        backgroundGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(34, 34, 34)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(28, 28, 28))}
        backgroundGradient.Rotation = 90
        backgroundGradient.Name = "backgroundGradient"
        backgroundGradient.Parent = background
    
        backgroundCorner.CornerRadius = UDim.new(0, 2)
        backgroundCorner.Name = "backgroundCorner"
        backgroundCorner.Parent = background
    
        waterText.Name = "notifText"
        waterText.Parent = background
        waterText.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        waterText.BackgroundTransparency = 1.000
        waterText.Position = UDim2.new(0, 0, -0.0416666679, 0)
        waterText.Size = UDim2.new(0, 0, 0, 24)
        waterText.Font = Enum.Font.Code
        waterText.Text = text
        waterText.TextColor3 = Color3.fromRGB(198, 198, 198)
        waterText.TextTransparency = 1
        waterText.TextSize = 14.000
        waterText.RichText = true
    
        local NewSize = TextService:GetTextSize(waterText.Text, waterText.TextSize, waterText.Font, Vector2.new(math.huge, math.huge))
        waterText.Size = UDim2.new(0, NewSize.X + 8, 0, 24)
    
        waterPadding.Name = "notifPadding"
        waterPadding.Parent = waterText
        waterPadding.PaddingBottom = UDim.new(0, 4)
        waterPadding.PaddingLeft = UDim.new(0, 4)
        waterPadding.PaddingRight = UDim.new(0, 4)
        waterPadding.PaddingTop = UDim.new(0, 4)
    
        backgroundLayout.Name = "backgroundLayout"
        backgroundLayout.Parent = background
        backgroundLayout.SortOrder = Enum.SortOrder.LayoutOrder
        backgroundLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    
        coroutine.wrap(function()
            TweenService:Create(edge, TweenTable["wm"], {BackgroundTransparency = 0}):Play()
            TweenService:Create(edge, TweenTable["wm"], {Size = UDim2.new(0, NewSize.x + 10, 0, 26)}):Play()
            TweenService:Create(background, TweenTable["wm"], {BackgroundTransparency = 0}):Play()
            TweenService:Create(background, TweenTable["wm"], {Size = UDim2.new(0, NewSize.x + 8, 0, 24)}):Play()
            wait(.2)
            TweenService:Create(bar, TweenTable["wm"], {Size = UDim2.new(0, NewSize.x + 8, 0, 1)}):Play()
            wait(.1)
            TweenService:Create(waterText, TweenTable["wm"], {TextTransparency = 0}):Play()
        end)()

        local NewWatermarkFunctions = {}
        function NewWatermarkFunctions:Hide()
            edge.Visible = false
            return NewWatermarkFunctions
        end
        --
        function NewWatermarkFunctions:Show()
            edge.Visible = true
            return NewWatermarkFunctions
        end
        --
        function NewWatermarkFunctions:Text(new)
            new = new or text
            waterText.Text = new
    
            local NewSize = TextService:GetTextSize(waterText.Text, waterText.TextSize, waterText.Font, Vector2.new(math.huge, math.huge))
            waterText.Size = UDim2.new(0, NewSize.X + 8, 0, 24)
            coroutine.wrap(function()
                TweenService:Create(edge, TweenTable["wm_2"], {Size = UDim2.new(0, NewSize.x + 10, 0, 26)}):Play()
                TweenService:Create(background, TweenTable["wm_2"], {Size = UDim2.new(0, NewSize.x + 8, 0, 24)}):Play()
                TweenService:Create(bar, TweenTable["wm_2"], {Size = UDim2.new(0, NewSize.x + 8, 0, 1)}):Play()
                TweenService:Create(waterText, TweenTable["wm_2"], {Size = UDim2.new(0, NewSize.x + 8, 0, 1)}):Play()
            end)()
    
            return NewWatermarkFunctions
        end
        --
        function NewWatermarkFunctions:Remove()
            Watermark:Destroy()
            return NewWatermarkFunctions
        end
        return NewWatermarkFunctions
    end

    function WatermarkFunctions:Hide()
        edge.Visible = false
        return WatermarkFunctions
    end
    --
    function WatermarkFunctions:Show()
        edge.Visible = true
        return WatermarkFunctions
    end
    --
    function WatermarkFunctions:Text(new)
        new = new or text
