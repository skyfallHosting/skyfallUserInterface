    contentKicker.BackgroundTransparency = 1
    contentKicker.Position = UDim2.new(0, 18, 0, 9)
    contentKicker.Size = UDim2.new(1, -138, 0, 24)
    contentKicker.Font = Enum.Font.GothamSemibold
    contentKicker.Text = productTitle
    contentKicker.TextColor3 = library.textPrimary
    contentKicker.TextSize = 18
    contentKicker.TextXAlignment = Enum.TextXAlignment.Left
    contentKicker.TextTruncate = Enum.TextTruncate.AtEnd
