                textboxTwoLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                textboxTwoLayout.SortOrder = Enum.SortOrder.LayoutOrder
                textboxTwoLayout.VerticalAlignment = Enum.VerticalAlignment.Center

                textboxLabel.Name = "textboxLabel"
                textboxLabel.Parent = textboxFrame
                textboxLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                textboxLabel.BackgroundTransparency = 1.000
                textboxLabel.Size = UDim2.new(0, _w, 0, 24)
                textboxLabel.Font = Enum.Font.Code
                textboxLabel.Text = text
                textboxLabel.TextColor3 = Color3.fromRGB(190, 190, 190)
                textboxLabel.TextSize = 14.000
                textboxLabel.TextWrapped = true
                textboxLabel.TextXAlignment = Enum.TextXAlignment.Left
                textboxLabel.RichText = true

                textboxPadding.Name = "textboxPadding"
                textboxPadding.Parent = textboxLabel
                textboxPadding.PaddingBottom = UDim.new(0, 6)
                textboxPadding.PaddingLeft = UDim.new(0, 2)
                textboxPadding.PaddingRight = UDim.new(0, 6)
                textboxPadding.PaddingTop = UDim.new(0, 6)

                CreateTween("TextBox", 0.07)

                textBoxValues:GetPropertyChangedSignal("Text"):Connect(function()
                    if format == "numbers" then
                        textBoxValues.Text = textBoxValues.Text:gsub("%D+", "")
                    end
                end)

                textBoxValues:GetPropertyChangedSignal("Text"):Connect(function()
                    if format == "lower" then
                        textBoxValues.Text = textBoxValues.Text:lower()
                    end
                end)

                textBoxValues:GetPropertyChangedSignal("Text"):Connect(function()
                    if format == "upper" then
                        textBoxValues.Text = textBoxValues.Text:upper()
                    end
                end)

                textBoxValues:GetPropertyChangedSignal("Text"):Connect(function()
                    if format == "all" or format == "" then
                        textBoxValues.Text = textBoxValues.Text
                    end
                end)

                textboxFrame.MouseEnter:Connect(function()
                    TweenService:Create(textboxLabel, TweenTable["TextBox"], {TextColor3 = Color3.fromRGB(210, 210, 210)}):Play()
                end)

                textboxFrame.MouseLeave:Connect(function()
                    TweenService:Create(textboxLabel, TweenTable["TextBox"], {TextColor3 = Color3.fromRGB(190, 190, 190)}):Play()
                end)

                textBoxValues.Focused:Connect(function()
                    TweenService:Create(textbox, TweenTable["TextBox"], {BackgroundColor3 = library.accentColor}):Play()
                end)

                textBoxValues.FocusLost:Connect(function()
                    TweenService:Create(textbox, TweenTable["TextBox"], {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
                end)

                textBoxValues.FocusLost:Connect(function(enterPressed)
                    if not autoexec then
                        if enterPressed then
                            callback(textBoxValues.Text)
                        end
                    else
                        callback(textBoxValues.Text)
                    end
                end)

                UpdatePageSize()

                local TextboxFunctions = {}
                function TextboxFunctions:Input(new)
                    new = new or textBoxValues.Text
                    textBoxValues.Text = new
                    return TextboxFunctions
                end
                --
                function TextboxFunctions:Fire()
                    callback(textBoxValues.Text)
                    return TextboxFunctions
                end
                --
                function TextboxFunctions:SetFunction(new)
                    new = new or callback
                    callback = new
                    return TextboxFunctions
                end
                --
                function TextboxFunctions:Text(new)
                    new = new or textboxLabel.Text
                    textboxLabel.Text = new
                    return TextboxFunctions
                end
                --
                function TextboxFunctions:Hide()
                    textboxFrame.Visible = false
                    return TextboxFunctions
                end
                --
                function TextboxFunctions:Show()
                    textboxFrame.Visible = true
                    return TextboxFunctions
                end
                --
                function TextboxFunctions:Remove()
                    textboxFrame:Destroy()
                    return TextboxFunctions
                end
                --
                function TextboxFunctions:Place(new)
                    new = new or textBoxValues.PlaceholderText
                    textBoxValues.PlaceholderText = new
                    return TextboxFunctions
                end
                return TextboxFunctions
            end
        end
        --
        function Components:NewSelector(text, default, list, callback)
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            text = text or "selector"
            default = default or ". . ."
            list = list or {}
            callback = callback or function() end

            local dropW = math.max(math.floor(_w * 0.45), 80)

            local selectorFrame = Instance.new("Frame")
            selectorFrame.Name = "selectorFrame"
            selectorFrame.Parent = page
            selectorFrame.BackgroundTransparency = 1
            selectorFrame.ClipsDescendants = true
            selectorFrame.Size = UDim2.new(0, _w, 0, 24)

            local selectorLabel = Instance.new("TextLabel")
            selectorLabel.Name = "selectorLabel"
            selectorLabel.Parent = selectorFrame
            selectorLabel.BackgroundTransparency = 1
            selectorLabel.Size = UDim2.new(0, _w - dropW - 4, 0, 24)
            selectorLabel.Position = UDim2.new(0, 0, 0, 0)
            selectorLabel.Font = Enum.Font.Code
            selectorLabel.Text = text
            selectorLabel.TextColor3 = Color3.fromRGB(190, 190, 190)
            selectorLabel.TextSize = 14
            selectorLabel.TextXAlignment = Enum.TextXAlignment.Left
            selectorLabel.RichText = true

            local selectorLabelPadding = Instance.new("UIPadding")
            selectorLabelPadding.Name = "selectorLabelPadding"
            selectorLabelPadding.Parent = selectorLabel
            selectorLabelPadding.PaddingLeft = UDim.new(0, 2)

            local selector = Instance.new("TextButton")
            selector.Name = "selector"
            selector.Parent = selectorFrame
            selector.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            selector.Position = UDim2.new(1, -dropW, 0, 1)
            selector.Size = UDim2.new(0, dropW, 0, 22)
            selector.AutoButtonColor = false
            selector.Text = ""
            selector.ClipsDescendants = false

            local selectorCorner = Instance.new("UICorner")
            selectorCorner.CornerRadius = UDim.new(0, 2)
            selectorCorner.Name = "selectorCorner"
            selectorCorner.Parent = selector

            local selectorTwo = Instance.new("Frame")
            selectorTwo.Name = "selectorTwo"
            selectorTwo.Parent = selector
            selectorTwo.AnchorPoint = Vector2.new(0.5, 0.5)
            selectorTwo.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            selectorTwo.Position = UDim2.new(0.5, 0, 0.5, 0)
            selectorTwo.Size = UDim2.new(0, dropW - 2, 0, 20)
            selectorTwo.ClipsDescendants = true

            local selectorTwoGradient = Instance.new("UIGradient")
            selectorTwoGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(34, 34, 34)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(28, 28, 28))}
            selectorTwoGradient.Rotation = 90
            selectorTwoGradient.Name = "selectorTwoGradient"
            selectorTwoGradient.Parent = selectorTwo

            local selectorTwoCorner = Instance.new("UICorner")
            selectorTwoCorner.CornerRadius = UDim.new(0, 2)
            selectorTwoCorner.Name = "selectorTwoCorner"
            selectorTwoCorner.Parent = selectorTwo

            local selectorText = Instance.new("TextLabel")
            selectorText.Name = "selectorText"
            selectorText.Parent = selectorTwo
            selectorText.BackgroundTransparency = 1
            selectorText.Size = UDim2.new(1, -20, 1, 0)
            selectorText.Position = UDim2.new(0, 0, 0, 0)
            selectorText.Font = Enum.Font.Code
            selectorText.Text = default
            selectorText.TextColor3 = Color3.fromRGB(160, 160, 160)
            selectorText.TextSize = 14
            selectorText.TextXAlignment = Enum.TextXAlignment.Left
            selectorText.ClipsDescendants = true
            selectorText.RichText = true

            local selectorTextPadding = Instance.new("UIPadding")
            selectorTextPadding.Name = "selectorTextPadding"
            selectorTextPadding.Parent = selectorText
            selectorTextPadding.PaddingLeft = UDim.new(0, 5)

            local selectorArrow = Instance.new("TextLabel")
            selectorArrow.Name = "selectorArrow"
            selectorArrow.Parent = selectorTwo
            selectorArrow.BackgroundTransparency = 1
            selectorArrow.Size = UDim2.new(0, 18, 1, 0)
            selectorArrow.Position = UDim2.new(1, -18, 0, 0)
            selectorArrow.Font = Enum.Font.Code
            selectorArrow.Text = "▼"
            selectorArrow.TextColor3 = Color3.fromRGB(120, 120, 120)
            selectorArrow.TextSize = 10
            selectorArrow.ZIndex = 5

            local selectorContainer = Instance.new("Frame")
            selectorContainer.Name = "selectorContainer"
            selectorContainer.Parent = selectorFrame
            selectorContainer.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            selectorContainer.BorderSizePixel = 0
            selectorContainer.Position = UDim2.new(1, -dropW, 0, 24)
            selectorContainer.Size = UDim2.new(0, dropW, 0, 0)
            selectorContainer.ClipsDescendants = true

            local selectorContainerCorner = Instance.new("UICorner")
            selectorContainerCorner.CornerRadius = UDim.new(0, 2)
            selectorContainerCorner.Parent = selectorContainer

            local selectorContainerStroke = Instance.new("UIStroke")
            selectorContainerStroke.Color = Color3.fromRGB(50, 50, 50)
            selectorContainerStroke.Thickness = 1
            selectorContainerStroke.Parent = selectorContainer

            local selectorContainerLayout = Instance.new("UIListLayout")
            selectorContainerLayout.Name = "selectorContainerLayout"
            selectorContainerLayout.Parent = selectorContainer
            selectorContainerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            selectorContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder

            CreateTween("selector", 0.08)
            CreateTween("selector_drop", 0.15)
            CreateTween("chevron", 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

            local selectorOpen = false
            local closedH = 24

            local function countOptions()
                local c = 0
                for _, child in ipairs(selectorContainer:GetChildren()) do
                    if child:IsA("TextButton") then c = c + 1 end
                end
                return c
            end

            local function collapseSelector()
                selectorOpen = false
                library._closeActivePopup = nil
                TweenService:Create(selectorArrow, TweenTable["chevron"], {Rotation = 0}):Play()
                TweenService:Create(selectorContainer, TweenTable["selector_drop"], {Size = UDim2.new(0, dropW, 0, 0)}):Play()
                TweenService:Create(selectorFrame, TweenTable["selector_drop"], {Size = UDim2.new(0, _w, 0, closedH)}):Play()
                TweenService:Create(selector, TweenTable["selector"], {BackgroundColor3 = Color3.fromRGB(50, 50, 50)}):Play()
                task.delay(0.15, UpdatePageSize)
            end

            local function expandSelector()
                if library._closeActivePopup then library._closeActivePopup() end
                selectorOpen = true
                library._closeActivePopup = collapseSelector
                TweenService:Create(selectorArrow, TweenTable["chevron"], {Rotation = 180}):Play()
                local optH = countOptions() * 20
                selectorContainer.Size = UDim2.new(0, dropW, 0, optH)
                TweenService:Create(selectorFrame, TweenTable["selector_drop"], {Size = UDim2.new(0, _w, 0, closedH + optH)}):Play()
                TweenService:Create(selector, TweenTable["selector"], {BackgroundColor3 = library.accentColor}):Play()
                task.delay(0.15, UpdatePageSize)
            end

            local function toggleSelector()
                if selectorOpen then collapseSelector() else expandSelector() end
            end

            selector.MouseButton1Click:Connect(toggleSelector)

            local function hookOptionClick(optionButton)
                optionButton.MouseButton1Click:Connect(function()
                    for _, x in next, selectorContainer:GetChildren() do
                        if x:IsA("TextButton") then
                            TweenService:Create(x, TweenTable["selector"], {TextColor3 = Color3.fromRGB(160, 160, 160)}):Play()
                        end
                    end
                    TweenService:Create(optionButton, TweenTable["selector"], {TextColor3 = library.accentColor}):Play()
                    selectorText.Text = optionButton.Text
                    callback(optionButton.Text)
                    collapseSelector()
                end)
            end

            for i, v in next, list do
                local optionButton = Instance.new("TextButton")
                optionButton.Name = "optionButton"
                optionButton.Parent = selectorContainer
                optionButton.BackgroundTransparency = 1
                optionButton.Size = UDim2.new(1, 0, 0, 20)
                optionButton.AutoButtonColor = false
                optionButton.Font = Enum.Font.Code
                optionButton.Text = v
                optionButton.TextColor3 = Color3.fromRGB(160, 160, 160)
                optionButton.TextSize = 14
                if optionButton.Text == default then
                    optionButton.TextColor3 = library.accentColor
                    callback(selectorText.Text)
                end
                hookOptionClick(optionButton)
            end

            selectorFrame.Size = UDim2.new(0, _w, 0, closedH)
            UpdatePageSize()

            local SelectorFunctions = {}
            function SelectorFunctions:AddOption(new, callback_f)
                new = new or "option"
                list[new] = new

                local optionButton = Instance.new("TextButton")
                optionButton.Name = "optionButton"
                optionButton.Parent = selectorContainer
                optionButton.BackgroundTransparency = 1
                optionButton.Size = UDim2.new(1, 0, 0, 20)
                optionButton.AutoButtonColor = false
                optionButton.Font = Enum.Font.Code
                optionButton.Text = new
                optionButton.TextColor3 = Color3.fromRGB(140, 140, 140)
                optionButton.TextSize = 14

                hookOptionClick(optionButton)
                if selectorOpen then expandSelector() end
                return SelectorFunctions
            end
            --
            function SelectorFunctions:RemoveOption(option)
                list[option] = nil

                for _, v in pairs(selectorContainer:GetDescendants()) do
                    if v:IsA("TextButton") and v.Text == option then
                        v:Destroy()
                        break
                    end
                end

                if selectorText.Text == option then
                    selectorText.Text = ". . ."
                end

                if selectorOpen then expandSelector() end
                return SelectorFunctions
            end
            --
            function SelectorFunctions:SetFunction(new)
                new = new or callback
                callback = new
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Text(new)
                new = new or selectorLabel.Text
                selectorLabel.Text = new
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Hide()
                selectorFrame.Visible = false
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Show()
                selectorFrame.Visible = true
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Remove()
                selectorFrame:Destroy()
                return SelectorFunctions
            end
            function SelectorFunctions:SetOption(option)
                for _, child in ipairs(selectorContainer:GetChildren()) do
                    if child:IsA("TextButton") then
                        TweenService:Create(child, TweenTable["selector"], {TextColor3 = Color3.fromRGB(140, 140, 140)}):Play()
                        if child.Text == option then
                            TweenService:Create(child, TweenTable["selector"], {TextColor3 = library.accentColor}):Play()
                            selectorText.Text = option
                            pcall(function() callback(option) end)
                        end
                    end
                end
                return SelectorFunctions
            end
            function SelectorFunctions:GetOption()
                return selectorText.Text
            end
            function SelectorFunctions:Flag(name)
                library:RegisterFlag(name, function() return selectorText.Text end, function(v) SelectorFunctions:SetOption(v) end, "selector")
                return SelectorFunctions
            end
            return SelectorFunctions
        end
        --
        function Components:NewSlider(text, suffix, compare, compareSign, values, callback)
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            text = text or "slider"
            suffix = suffix or ""
            compare = compare or false
            compareSign = compareSign or "/"
            values = values or {
                min = values.min or 0,
                max = values.max or 100,
                default = values.default or 0
            }
            callback = callback or function() end

            local _step = values.step
            if not _step then
                values.max = values.max + 1
            end

            local sliderFrame = Instance.new("Frame")
            local sliderFolder = Instance.new("Folder")
            local textboxFolderLayout = Instance.new("UIListLayout")
            local sliderButton = Instance.new("TextButton")
            local sliderButtonCorner = Instance.new("UICorner")
            local sliderBackground = Instance.new("Frame")
            local sliderButtonCorner_2 = Instance.new("UICorner")
            local sliderBackgroundGradient = Instance.new("UIGradient")
            local sliderBackgroundLayout = Instance.new("UIListLayout")
            local sliderIndicator = Instance.new("Frame")
            local sliderIndicatorStraint = Instance.new("UISizeConstraint")
            local sliderIndicatorGradient = Instance.new("UIGradient")
            local sliderIndicatorCorner = Instance.new("UICorner")
            local sliderBackgroundPadding = Instance.new("UIPadding")
            local sliderButtonLayout = Instance.new("UIListLayout")
            local sliderLabel = Instance.new("TextLabel")
            local sliderPadding = Instance.new("UIPadding")
            local sliderValue = Instance.new("TextLabel")

            sliderFrame.Name = "sliderFrame"
            sliderFrame.Parent = page
            sliderFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sliderFrame.BackgroundTransparency = 1.000
            sliderFrame.ClipsDescendants = true
            sliderFrame.Position = UDim2.new(0.00499999989, 0, 0.667630076, 0)
            sliderFrame.Size = UDim2.new(0, _w, 0, 40)

            sliderFolder.Name = "sliderFolder"
            sliderFolder.Parent = sliderFrame

            textboxFolderLayout.Name = "textboxFolderLayout"
            textboxFolderLayout.Parent = sliderFolder
            textboxFolderLayout.FillDirection = Enum.FillDirection.Horizontal
            textboxFolderLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            textboxFolderLayout.SortOrder = Enum.SortOrder.LayoutOrder
            textboxFolderLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
            textboxFolderLayout.Padding = UDim.new(0, 4)

            sliderButton.Name = "sliderButton"
            sliderButton.Parent = sliderFolder
            sliderButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            sliderButton.Position = UDim2.new(0.348484844, 0, 0.600000024, 0)
            sliderButton.Size = UDim2.new(0, _w, 0, 16)
            sliderButton.AutoButtonColor = false
            sliderButton.Font = Enum.Font.SourceSans
            sliderButton.Text = ""
            sliderButton.TextColor3 = Color3.fromRGB(0, 0, 0)
            sliderButton.TextSize = 14.000

            sliderButtonCorner.CornerRadius = UDim.new(0, 2)
            sliderButtonCorner.Name = "sliderButtonCorner"
            sliderButtonCorner.Parent = sliderButton

            sliderBackground.Name = "sliderBackground"
            sliderBackground.Parent = sliderButton
            sliderBackground.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sliderBackground.Size = UDim2.new(0, _w - 2, 0, 14)
            sliderBackground.ClipsDescendants = true

            sliderButtonCorner_2.CornerRadius = UDim.new(0, 2)
            sliderButtonCorner_2.Name = "sliderButtonCorner"
            sliderButtonCorner_2.Parent = sliderBackground

            sliderBackgroundGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(34, 34, 34)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(28, 28, 28))}
            sliderBackgroundGradient.Rotation = 90
            sliderBackgroundGradient.Name = "sliderBackgroundGradient"
            sliderBackgroundGradient.Parent = sliderBackground

            sliderBackgroundLayout.Name = "sliderBackgroundLayout"
            sliderBackgroundLayout.Parent = sliderBackground
            sliderBackgroundLayout.SortOrder = Enum.SortOrder.LayoutOrder
            sliderBackgroundLayout.VerticalAlignment = Enum.VerticalAlignment.Center

            sliderIndicator.Name = "sliderIndicator"
            sliderIndicator.Parent = sliderBackground
            sliderIndicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sliderIndicator.BorderSizePixel = 0
            sliderIndicator.Position = UDim2.new(0, 0, -0.100000001, 0)
            sliderIndicator.Size = UDim2.new(0, 0, 0, 12)

            sliderIndicatorStraint.Name = "sliderIndicatorStraint"
            sliderIndicatorStraint.Parent = sliderIndicator
            sliderIndicatorStraint.MaxSize = Vector2.new(392, 12)

            sliderIndicatorGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, library.accentColor), ColorSequenceKeypoint.new(1, accentDark(0.81))}
            sliderIndicatorGradient.Rotation = 90
            sliderIndicatorGradient.Name = "sliderIndicatorGradient"
            sliderIndicatorGradient.Parent = sliderIndicator

            sliderIndicatorCorner.CornerRadius = UDim.new(0, 2)
            sliderIndicatorCorner.Name = "sliderIndicatorCorner"
            sliderIndicatorCorner.Parent = sliderIndicator

            sliderBackgroundPadding.Name = "sliderBackgroundPadding"
            sliderBackgroundPadding.Parent = sliderBackground
            sliderBackgroundPadding.PaddingBottom = UDim.new(0, 2)
            sliderBackgroundPadding.PaddingLeft = UDim.new(0, 1)
            sliderBackgroundPadding.PaddingRight = UDim.new(0, 1)
            sliderBackgroundPadding.PaddingTop = UDim.new(0, 2)

            sliderButtonLayout.Name = "sliderButtonLayout"
            sliderButtonLayout.Parent = sliderButton
            sliderButtonLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            sliderButtonLayout.SortOrder = Enum.SortOrder.LayoutOrder
            sliderButtonLayout.VerticalAlignment = Enum.VerticalAlignment.Center

            sliderLabel.Name = "sliderLabel"
            sliderLabel.Parent = sliderFrame
            sliderLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sliderLabel.BackgroundTransparency = 1.000
            sliderLabel.Size = UDim2.new(0, _w, 0, 24)
            sliderLabel.Font = Enum.Font.Code
            sliderLabel.Text = text
            sliderLabel.TextColor3 = Color3.fromRGB(190, 190, 190)
            sliderLabel.TextSize = 14.000
            sliderLabel.TextWrapped = true
            sliderLabel.TextXAlignment = Enum.TextXAlignment.Left
            sliderLabel.RichText = true

            sliderPadding.Name = "sliderPadding"
            sliderPadding.Parent = sliderLabel
            sliderPadding.PaddingBottom = UDim.new(0, 6)
            sliderPadding.PaddingLeft = UDim.new(0, 2)
            sliderPadding.PaddingRight = UDim.new(0, 6)
            sliderPadding.PaddingTop = UDim.new(0, 6)

            sliderValue.Name = "sliderValue"
            sliderValue.Parent = sliderLabel
            sliderValue.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sliderValue.BackgroundTransparency = 1.000
            sliderValue.Position = UDim2.new(0.577319562, 0, 0, 0)
            sliderValue.Size = UDim2.new(0, 169, 0, 15)
            sliderValue.Font = Enum.Font.Code
            sliderValue.Text = values.default
            sliderValue.TextColor3 = Color3.fromRGB(140, 140, 140)
            sliderValue.TextSize = 14.000
            sliderValue.TextXAlignment = Enum.TextXAlignment.Right


            local calc1 = values.max - values.min
            local calc2 = values.default - values.min
            local calc3 = calc2 / calc1
            local calc4 = calc3 * sliderBackground.AbsoluteSize.X
            local Calculation = calc4
            sliderIndicator.Size = UDim2.new(0, Calculation, 0, 12)
            sliderValue.Text = values.default

            CreateTween("slider_drag", 0.008)

            local ValueNum = values.default
            local slideText = compare and ValueNum .. compareSign .. tostring(values.max - 1) .. suffix or ValueNum .. suffix
            sliderValue.Text = slideText

            local sliding = false
            local function updateSliderFromX(posX)
                local rel = math.clamp((posX - sliderBackground.AbsolutePosition.X) / math.max(sliderBackground.AbsoluteSize.X, 1), 0, 1)
                local raw = rel * (tonumber(values.max) - tonumber(values.min)) + tonumber(values.min)
                if _step then
                    ValueNum = math.clamp(math.floor(raw / _step + 0.5) * _step, values.min, values.max)
                    local dec = tostring(_step):match("%.(%d+)")
                    if dec then ValueNum = tonumber(string.format("%." .. #dec .. "f", ValueNum)) end
                else
                    ValueNum = math.floor(raw)
                end
                TweenService:Create(sliderIndicator, TweenTable["slider_drag"], {Size = UDim2.new(0, rel * sliderBackground.AbsoluteSize.X, 0, 12)}):Play()
                local maxDisplay = _step and values.max or (values.max - 1)
                slideText = compare and ValueNum .. compareSign .. tostring(maxDisplay) .. suffix or ValueNum .. suffix
                sliderValue.Text = slideText
                pcall(function() callback(ValueNum) end)
            end

            sliderButton.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateSliderFromX(inp.Position.X)
                end
            end)

            table.insert(library._connections, UserInputService.InputChanged:Connect(function(inp)
                if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    updateSliderFromX(inp.Position.X)
                end
            end))

            table.insert(library._connections, UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end))

            UpdatePageSize()

            local SliderFunctions = {}
            function SliderFunctions:Value(new)
                local ncalc1 = new - values.min
                local ncalc2 = ncalc1 / calc1
                local ncalc3 = ncalc2 * sliderBackground.AbsoluteSize.X
                local nCalculation = ncalc3
                sliderIndicator.Size = UDim2.new(0, nCalculation, 0, 12)
                slideText = compare and new .. compareSign .. tostring(values.max - 1) .. suffix or new .. suffix
                sliderValue.Text = slideText
                return SliderFunctions
            end
            --
            function SliderFunctions:Max(new)
                new = new or values.max
                values.max = new + 1
                slideText = compare and ValueNum .. compareSign .. tostring(values.max - 1) .. suffix or ValueNum .. suffix
                return SliderFunctions
            end
            --
            function SliderFunctions:Min(new)
                new = new or values.min
                values.min = new
                slideText = compare and new .. compareSign .. tostring(values.max - 1) .. suffix or ValueNum .. suffix
                return SliderFunctions
            end
            --
            function SliderFunctions:SetFunction(new)
                new = new or callback
                callback = new
                return SliderFunctions
            end
            --
            function SliderFunctions:Text(new)
                new = new or sliderLabel.Text
                sliderLabel.Text = new
                return SliderFunctions
            end
            --
            function SliderFunctions:Hide()
                sliderFrame.Visible = false
                return SliderFunctions
            end
            --
            function SliderFunctions:Show()
                sliderFrame.Visible = true
                return SliderFunctions
            end
            --
            function SliderFunctions:Remove()
                sliderFrame:Destroy()
                return SliderFunctions
            end
            function SliderFunctions:Flag(name)
                library:RegisterFlag(name, function() return ValueNum end, function(v) SliderFunctions:Value(v); pcall(function() callback(v) end) end, "slider")
                return SliderFunctions
            end
            return SliderFunctions
        end
        --
        function Components:NewColorPicker(text, default, callback)
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            local screen = self._screen
            text = text or "Color Picker"
            default = default or Color3.fromRGB(255, 255, 255)
            callback = callback or function() end

            local currentColor = default
            local cpH, cpS, cpV = Color3.toHSV(default)
            local pickerOpen = false
            local svSize = 200
            local hueBarWidth = 16
            local popupW = svSize + hueBarWidth + 24
            local popupH = svSize + 16

            local cpFrame = Instance.new("Frame")
            cpFrame.Name = "colorPickerFrame"
            cpFrame.Parent = page
            cpFrame.BackgroundTransparency = 1
            cpFrame.Size = UDim2.new(0, _w, 0, 22)

            local cpLabel = Instance.new("TextLabel")
            cpLabel.Name = "cpLabel"
            cpLabel.Parent = cpFrame
            cpLabel.BackgroundTransparency = 1
            cpLabel.Size = UDim2.new(0, 300, 0, 22)
            cpLabel.Font = Enum.Font.Code
            cpLabel.Text = text
            cpLabel.TextColor3 = Color3.fromRGB(190, 190, 190)
            cpLabel.TextSize = 14
            cpLabel.TextXAlignment = Enum.TextXAlignment.Left
            cpLabel.RichText = true
            local cpLabelPad = Instance.new("UIPadding")
            cpLabelPad.Parent = cpLabel
            cpLabelPad.PaddingLeft = UDim.new(0, 2)

            local preview = Instance.new("TextButton")
            preview.Name = "colorPreview"
            preview.Parent = cpFrame
            preview.Position = UDim2.new(1, -30, 0, 2)
            preview.Size = UDim2.new(0, 18, 0, 18)
            preview.BackgroundColor3 = currentColor
            preview.BorderSizePixel = 0
            preview.AutoButtonColor = false
            preview.Text = ""
            local previewEdge = Instance.new("UIStroke")
            previewEdge.Color = Color3.fromRGB(60, 60, 60)
            previewEdge.Thickness = 1
            previewEdge.Parent = preview
            local previewCorner = Instance.new("UICorner")
            previewCorner.CornerRadius = UDim.new(0, 2)
            previewCorner.Parent = preview

            local popup = Instance.new("Frame")
            popup.Name = "cpPopup"
            popup.Parent = screen
            popup.Size = UDim2.new(0, popupW, 0, popupH)
            popup.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            popup.BorderSizePixel = 0
            popup.Visible = false
            popup.ZIndex = 100
            local popupCorner = Instance.new("UICorner")
            popupCorner.CornerRadius = UDim.new(0, 4)
            popupCorner.Parent = popup
            local popupStroke = Instance.new("UIStroke")
            popupStroke.Color = Color3.fromRGB(60, 60, 60)
            popupStroke.Thickness = 1
            popupStroke.Parent = popup

            local svFrame = Instance.new("ImageLabel")
            svFrame.Name = "svSquare"
            svFrame.Parent = popup
            svFrame.Position = UDim2.new(0, 8, 0, 8)
            svFrame.Size = UDim2.new(0, svSize, 0, svSize)
            svFrame.BackgroundColor3 = Color3.fromHSV(cpH, 1, 1)
            svFrame.BorderSizePixel = 0
            svFrame.ClipsDescendants = true
            svFrame.Image = "rbxassetid://4155801252"
            svFrame.ImageTransparency = 0
            svFrame.ScaleType = Enum.ScaleType.Stretch
            svFrame.Active = true
            svFrame.ZIndex = 101
            local svStroke = Instance.new("UIStroke")
            svStroke.Color = Color3.fromRGB(60, 60, 60)
            svStroke.Thickness = 1
            svStroke.Parent = svFrame

            local svCursor = Instance.new("Frame")
            svCursor.Name = "svCursor"
            svCursor.Parent = svFrame
            svCursor.Size = UDim2.new(0, 6, 0, 6)
            svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
            svCursor.Position = UDim2.new(cpS, 0, 1 - cpV, 0)
            svCursor.BackgroundColor3 = Color3.new(1, 1, 1)
            svCursor.BorderSizePixel = 0
            svCursor.ZIndex = 105
            local svCursorCorner = Instance.new("UICorner")
            svCursorCorner.CornerRadius = UDim.new(1, 0)
            svCursorCorner.Parent = svCursor
            local svCursorStroke = Instance.new("UIStroke")
            svCursorStroke.Color = Color3.new(0, 0, 0)
            svCursorStroke.Thickness = 1
            svCursorStroke.Parent = svCursor

            local hueBar = Instance.new("Frame")
            hueBar.Name = "hueBar"
            hueBar.Parent = popup
            hueBar.Position = UDim2.new(0, 8 + svSize + 8, 0, 8)
            hueBar.Size = UDim2.new(0, hueBarWidth, 0, svSize)
            hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
            hueBar.BorderSizePixel = 0
            hueBar.ClipsDescendants = true
            hueBar.Active = true
            hueBar.ZIndex = 101
            local hueStroke = Instance.new("UIStroke")
            hueStroke.Color = Color3.fromRGB(60, 60, 60)
            hueStroke.Thickness = 1
            hueStroke.Parent = hueBar

            local hueKeypoints = {}
            for i = 0, 1, 0.1 do
                table.insert(hueKeypoints, ColorSequenceKeypoint.new(math.clamp(i, 0, 1), Color3.fromHSV(math.clamp(i, 0, 1), 1, 1)))
            end
            local hueGrad = Instance.new("UIGradient")
            hueGrad.Color = ColorSequence.new(hueKeypoints)
            hueGrad.Rotation = 90
            hueGrad.Parent = hueBar

            local hueCursor = Instance.new("Frame")
            hueCursor.Name = "hueCursor"
            hueCursor.Parent = hueBar
            hueCursor.Size = UDim2.new(1, 4, 0, 3)
            hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
            hueCursor.Position = UDim2.new(0.5, 0, cpH, 0)
            hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
            hueCursor.BorderSizePixel = 0
            hueCursor.ZIndex = 105
            local hueCursorStroke = Instance.new("UIStroke")
            hueCursorStroke.Color = Color3.new(0, 0, 0)
            hueCursorStroke.Thickness = 1
            hueCursorStroke.Parent = hueCursor

            local function updateCPColor()
                currentColor = Color3.fromHSV(cpH, cpS, cpV)
                preview.BackgroundColor3 = currentColor
                svFrame.BackgroundColor3 = Color3.fromHSV(cpH, 1, 1)
                svCursor.Position = UDim2.new(cpS, 0, 1 - cpV, 0)
                hueCursor.Position = UDim2.new(0.5, 0, cpH, 0)
                pcall(function() callback(currentColor) end)
            end

            local function positionPopup()
                local px = preview.AbsolutePosition.X - popupW - 4
                local py = preview.AbsolutePosition.Y
                local viewportSize = workspace.CurrentCamera.ViewportSize
                if px < 0 then px = preview.AbsolutePosition.X + 22 end
                if py + popupH > viewportSize.Y then py = viewportSize.Y - popupH - 4 end
                popup.Position = UDim2.new(0, px, 0, py)
            end

            local function closePopup()
                if not pickerOpen then return end
                pickerOpen = false
                popup.Visible = false
                _popupActive = false
                if library._closeActivePopup == closePopup then
                    library._closeActivePopup = nil
                end
            end

            preview.MouseButton1Click:Connect(function()
                if pickerOpen then
                    closePopup()
                else
                    if library._closeActivePopup then
                        library._closeActivePopup()
                    end
                    positionPopup()
                    popup.Visible = true
                    pickerOpen = true
                    _popupActive = true
                    library._closeActivePopup = closePopup
                end
            end)

            table.insert(library._connections, UserInputService.InputBegan:Connect(function(inp)
                if not pickerOpen then return end
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    local pos = inp.Position
                    local pAbs = popup.AbsolutePosition
                    local pSize = popup.AbsoluteSize
                    if pos.X < pAbs.X or pos.X > pAbs.X + pSize.X or pos.Y < pAbs.Y or pos.Y > pAbs.Y + pSize.Y then
                        local prAbs = preview.AbsolutePosition
                        local prSize = preview.AbsoluteSize
                        if pos.X < prAbs.X or pos.X > prAbs.X + prSize.X or pos.Y < prAbs.Y or pos.Y > prAbs.Y + prSize.Y then
                            closePopup()
                        end
                    end
                end
            end))

            svFrame.InputBegan:Connect(function(inp)
                if not pickerOpen then return end
                if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
                while pickerOpen and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    local absPos = svFrame.AbsolutePosition
                    local absSize = svFrame.AbsoluteSize
                    cpS = math.clamp((Mouse.X - absPos.X) / absSize.X, 0, 1)
                    cpV = 1 - math.clamp((Mouse.Y - absPos.Y) / absSize.Y, 0, 1)
                    updateCPColor()
                    RunService.RenderStepped:Wait()
                end
            end)

            hueBar.InputBegan:Connect(function(inp)
                if not pickerOpen then return end
                if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
                while pickerOpen and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    local absPos = hueBar.AbsolutePosition
                    local absSize = hueBar.AbsoluteSize
                    cpH = math.clamp((Mouse.Y - absPos.Y) / absSize.Y, 0, 1)
                    updateCPColor()
                    RunService.RenderStepped:Wait()
                end
            end)

            UpdatePageSize()

            local CPFunctions = {}
            function CPFunctions:SetColor(color)
                cpH, cpS, cpV = Color3.toHSV(color)
                currentColor = color
                preview.BackgroundColor3 = color
                svFrame.BackgroundColor3 = Color3.fromHSV(cpH, 1, 1)
                svCursor.Position = UDim2.new(cpS, 0, 1 - cpV, 0)
                hueCursor.Position = UDim2.new(0.5, 0, cpH, 0)
                return CPFunctions
            end
            function CPFunctions:GetColor()
                return currentColor
            end
            function CPFunctions:Text(new)
                cpLabel.Text = new or text
                return CPFunctions
            end
            function CPFunctions:SetFunction(new)
                callback = new or callback
                return CPFunctions
            end
            function CPFunctions:Hide()
                cpFrame.Visible = false
                return CPFunctions
            end
            function CPFunctions:Show()
                cpFrame.Visible = true
                return CPFunctions
            end
            function CPFunctions:Remove()
                cpFrame:Destroy()
                popup:Destroy()
                return CPFunctions
            end
            function CPFunctions:Flag(name)
                library:RegisterFlag(name, function() return currentColor end, function(val) CPFunctions:SetColor(val); pcall(function() callback(val) end) end, "color")
                return CPFunctions
            end
            return CPFunctions
        end
        --
        function Components:NewSeperator()
