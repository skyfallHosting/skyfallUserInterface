        --
        function Components:NewSelector(text, default, list, callback)
            self._lastComponentType = "other"
            self._lastToggleRecord = nil
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            text = text or "selector"
            default = default or ". . ."
            list = list or {}
            callback = callback or function() end

            -- Keep the selector compact. The dropdown itself is an overlay popup and
            -- never participates in the page/groupbox AutomaticSize calculation.
            local dropW = math.max(math.floor(_w * 0.48), 118)
            local rowH = 34
            local optionH = 30
            local optionGap = 2
            local popupPad = 6
            local maxPopupH = 166
            local popupZ = 80

            local selectorFrame = Instance.new("Frame")
            selectorFrame.Name = "selectorFrame"
            selectorFrame.Parent = page
            selectorFrame.BackgroundTransparency = 1
            selectorFrame.ClipsDescendants = false
            selectorFrame.Size = UDim2.new(0, _w, 0, rowH)
            selectorFrame.ZIndex = popupZ - 10

            local selectorLabel = Instance.new("TextLabel")
            selectorLabel.Name = "selectorLabel"
            selectorLabel.Parent = selectorFrame
            selectorLabel.BackgroundTransparency = 1
            selectorLabel.Size = UDim2.new(0, _w - dropW - 12, 0, rowH)
            selectorLabel.Position = UDim2.new(0, 0, 0, 0)
            selectorLabel.Font = Enum.Font.Gotham
            selectorLabel.Text = text
            selectorLabel.TextColor3 = library.textSecondary
            selectorLabel.TextSize = 13
            selectorLabel.TextXAlignment = Enum.TextXAlignment.Left
            selectorLabel.RichText = true
            selectorLabel.ZIndex = popupZ - 9

            local selectorLabelPadding = Instance.new("UIPadding")
            selectorLabelPadding.Name = "selectorLabelPadding"
            selectorLabelPadding.Parent = selectorLabel
            selectorLabelPadding.PaddingLeft = UDim.new(0, 2)

            local selector = Instance.new("TextButton")
            selector.Name = "selector"
            selector.Parent = selectorFrame
            selector.BackgroundColor3 = library.strokeColor
            selector.Position = UDim2.new(1, -dropW, 0, 2)
            selector.Size = UDim2.new(0, dropW, 0, 30)
            selector.AutoButtonColor = false
            selector.Text = ""
            selector.ClipsDescendants = false
            selector.ZIndex = popupZ - 8

            local selectorCorner = Instance.new("UICorner")
            selectorCorner.CornerRadius = UDim.new(0, 8)
            selectorCorner.Parent = selector

            local selectorStroke = Instance.new("UIStroke")
            selectorStroke.Name = "selectorStroke"
            selectorStroke.Parent = selector
            selectorStroke.Color = library.strokeColor
            selectorStroke.Transparency = 0.60
            selectorStroke.Thickness = 1

            local selectorGlow = library:AddSoftGlow(selector, 1, 10, library.accentColor, popupZ - 9)

            local selectorTwo = Instance.new("Frame")
            selectorTwo.Name = "selectorTwo"
            selectorTwo.Parent = selector
            selectorTwo.AnchorPoint = Vector2.new(0.5, 0.5)
            selectorTwo.BackgroundColor3 = library.inputColor
            selectorTwo.Position = UDim2.new(0.5, 0, 0.5, 0)
            selectorTwo.Size = UDim2.new(1, -2, 1, -2)
            selectorTwo.ClipsDescendants = true
            selectorTwo.ZIndex = popupZ - 7

            local selectorTwoGradient = Instance.new("UIGradient")
            selectorTwoGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(28, 29, 38)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(22, 23, 31))
            }
            selectorTwoGradient.Rotation = 90
            selectorTwoGradient.Parent = selectorTwo

            local selectorTwoCorner = Instance.new("UICorner")
            selectorTwoCorner.CornerRadius = UDim.new(0, 7)
            selectorTwoCorner.Parent = selectorTwo

            local selectorText = Instance.new("TextLabel")
            selectorText.Name = "selectorText"
            selectorText.Parent = selectorTwo
            selectorText.BackgroundTransparency = 1
            selectorText.Size = UDim2.new(1, -28, 1, 0)
            selectorText.Position = UDim2.new(0, 0, 0, 0)
            selectorText.Font = Enum.Font.GothamMedium
            selectorText.Text = tostring(default)
            selectorText.TextColor3 = library.textPrimary
            selectorText.TextSize = 12
            selectorText.TextXAlignment = Enum.TextXAlignment.Left
            selectorText.ClipsDescendants = true
            selectorText.RichText = true
            selectorText.ZIndex = popupZ - 6

            local selectorTextPadding = Instance.new("UIPadding")
            selectorTextPadding.Parent = selectorText
            selectorTextPadding.PaddingLeft = UDim.new(0, 8)

            local selectorArrow = Instance.new("ImageLabel")
            selectorArrow.Name = "selectorArrow"
            selectorArrow.Parent = selectorTwo
            selectorArrow.BackgroundTransparency = 1
            selectorArrow.Size = UDim2.new(0, 13, 0, 13)
            selectorArrow.Position = UDim2.new(1, -20, 0.5, -6)
            selectorArrow.ImageColor3 = library.textMuted
            selectorArrow.ScaleType = Enum.ScaleType.Fit
            selectorArrow.ZIndex = popupZ - 5

            local fallbackArrow = nil
            local chevronAsset = library:LoadLucideIcon("chevron-down")
            if chevronAsset then
                selectorArrow.Image = chevronAsset
            else
                selectorArrow.Visible = false
                fallbackArrow = Instance.new("TextLabel")
                fallbackArrow.Name = "selectorArrowFallback"
                fallbackArrow.Parent = selectorTwo
                fallbackArrow.BackgroundTransparency = 1
                fallbackArrow.Size = UDim2.new(0, 18, 1, 0)
                fallbackArrow.Position = UDim2.new(1, -20, 0, 0)
                fallbackArrow.Font = Enum.Font.GothamMedium
                fallbackArrow.Text = "⌄"
                fallbackArrow.TextColor3 = library.textMuted
                fallbackArrow.TextSize = 12
                fallbackArrow.ZIndex = popupZ - 5
            end

            -- Popup glow lives outside the ScrollingFrame so it cannot be clipped by
            -- the scrolling viewport.
            local popupGlowHost = Instance.new("Frame")
            popupGlowHost.Name = "selectorPopupGlowHost"
            popupGlowHost.Parent = selectorFrame
            popupGlowHost.BackgroundTransparency = 1
            popupGlowHost.Position = UDim2.new(1, -dropW, 0, rowH + 3)
            popupGlowHost.Size = UDim2.new(0, dropW, 0, 0)
            popupGlowHost.Visible = false
            popupGlowHost.ZIndex = popupZ - 2

            local popupGlow = library:AddSoftGlow(popupGlowHost, 0.91, 14, library.accentColor, popupZ - 3)

            local selectorContainer = Instance.new("ScrollingFrame")
            selectorContainer.Name = "selectorContainer"
            selectorContainer.Parent = selectorFrame
            selectorContainer.BackgroundColor3 = Color3.fromRGB(16, 17, 24)
            selectorContainer.BackgroundTransparency = 0.02
            selectorContainer.BorderSizePixel = 0
            selectorContainer.Position = UDim2.new(1, -dropW, 0, rowH + 3)
            selectorContainer.Size = UDim2.new(0, dropW, 0, 0)
            selectorContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
            selectorContainer.ScrollBarThickness = 2
            selectorContainer.ScrollBarImageColor3 = library.accentSoft
            selectorContainer.ScrollBarImageTransparency = 0.32
            selectorContainer.ScrollingDirection = Enum.ScrollingDirection.Y
            selectorContainer.ClipsDescendants = true
            selectorContainer.Visible = false
            selectorContainer.ZIndex = popupZ

            local selectorContainerCorner = Instance.new("UICorner")
            selectorContainerCorner.CornerRadius = UDim.new(0, 9)
            selectorContainerCorner.Parent = selectorContainer

            local selectorContainerStroke = Instance.new("UIStroke")
            selectorContainerStroke.Color = library.accentSoft
            selectorContainerStroke.Transparency = 0.42
            selectorContainerStroke.Thickness = 1
            selectorContainerStroke.Parent = selectorContainer

            local popupGradient = Instance.new("UIGradient")
            popupGradient.Name = "selectorPopupGradient"
            popupGradient.Parent = selectorContainer
            popupGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(24, 22, 34)),
                ColorSequenceKeypoint.new(0.45, Color3.fromRGB(17, 18, 26)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(13, 14, 21))
            }
            popupGradient.Rotation = 90

            local popupPadding = Instance.new("UIPadding")
            popupPadding.Parent = selectorContainer
            popupPadding.PaddingTop = UDim.new(0, popupPad)
            popupPadding.PaddingBottom = UDim.new(0, popupPad)
            popupPadding.PaddingLeft = UDim.new(0, 4)
            popupPadding.PaddingRight = UDim.new(0, 4)

            local selectorContainerLayout = Instance.new("UIListLayout")
            selectorContainerLayout.Name = "selectorContainerLayout"
            selectorContainerLayout.Parent = selectorContainer
            selectorContainerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            selectorContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
            selectorContainerLayout.Padding = UDim.new(0, optionGap)

            CreateTween("selector", 0.09)
            CreateTween("selector_drop", 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            CreateTween("chevron", 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

            local selectorOpen = false
            local popupHeight = 0

            local function optionButtons()
                local result = {}
                for _, child in ipairs(selectorContainer:GetChildren()) do
                    if child:IsA("TextButton") and child.Name == "optionButton" then
                        table.insert(result, child)
                    end
                end
                return result
            end

            local function refreshPopupGeometry()
                local count = #optionButtons()
                local contentH = popupPad * 2
                if count > 0 then
                    contentH = contentH + count * optionH + (count - 1) * optionGap
                end
                popupHeight = math.min(contentH, maxPopupH)
                selectorContainer.CanvasSize = UDim2.new(0, 0, 0, contentH)

                -- Prefer opening down. If it would leave the viewport, flip upward.
                local viewportY = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y or 720
                local selectorBottom = selector.AbsolutePosition.Y + selector.AbsoluteSize.Y
                local roomBelow = viewportY - selectorBottom - 18
                local openAbove = popupHeight > roomBelow and selector.AbsolutePosition.Y > popupHeight + 18
                local yOffset = openAbove and (-popupHeight - 3) or (rowH + 3)

                selectorContainer.Position = UDim2.new(1, -dropW, 0, yOffset)
                popupGlowHost.Position = selectorContainer.Position
                return popupHeight
            end

            local function setChevron(open)
                local rotation = open and 180 or 0
                local color = open and library.accentColor or library.textMuted
                if selectorArrow.Visible then
                    TweenService:Create(selectorArrow, TweenTable["chevron"], {
                        Rotation = rotation,
                        ImageColor3 = color
                    }):Play()
                elseif fallbackArrow then
                    TweenService:Create(fallbackArrow, TweenTable["chevron"], {
                        Rotation = rotation,
                        TextColor3 = color
                    }):Play()
                end
            end

            local function collapseSelector()
                if not selectorOpen then return end
                selectorOpen = false
                _popupActive = false
                if library._closeActivePopup == collapseSelector then
                    library._closeActivePopup = nil
                end
                setChevron(false)

                TweenService:Create(selectorContainer, TweenTable["selector_drop"], {
                    Size = UDim2.new(0, dropW, 0, 0)
                }):Play()
                TweenService:Create(popupGlowHost, TweenTable["selector_drop"], {
                    Size = UDim2.new(0, dropW, 0, 0)
                }):Play()
                TweenService:Create(selector, TweenTable["selector"], {
                    BackgroundColor3 = library.strokeColor
                }):Play()
                TweenService:Create(selectorStroke, TweenTable["selector"], {
                    Color = library.strokeColor,
                    Transparency = 0.60
                }):Play()
                if selectorGlow then
                    TweenService:Create(selectorGlow, TweenTable["selector"], {ImageTransparency = 1}):Play()
                end
                if popupGlow then
                    TweenService:Create(popupGlow, TweenTable["selector_drop"], {ImageTransparency = 1}):Play()
                end

                task.delay(0.15, function()
                    if not selectorOpen then
                        selectorContainer.Visible = false
                        popupGlowHost.Visible = false
                    end
                end)
            end

            local function expandSelector()
                if selectorOpen then return end
                if library._closeActivePopup then
                    pcall(library._closeActivePopup)
                end

                selectorOpen = true
                _popupActive = true
                library._closeActivePopup = collapseSelector
                local h = refreshPopupGeometry()
                if h <= 0 then
                    selectorOpen = false
                    _popupActive = false
                    library._closeActivePopup = nil
                    return
                end

                selectorContainer.Visible = true
                popupGlowHost.Visible = true
                selectorContainer.Size = UDim2.new(0, dropW, 0, 0)
                popupGlowHost.Size = UDim2.new(0, dropW, 0, 0)
                setChevron(true)

                TweenService:Create(selectorContainer, TweenTable["selector_drop"], {
                    Size = UDim2.new(0, dropW, 0, h)
                }):Play()
                TweenService:Create(popupGlowHost, TweenTable["selector_drop"], {
                    Size = UDim2.new(0, dropW, 0, h)
                }):Play()
                TweenService:Create(selector, TweenTable["selector"], {
                    BackgroundColor3 = accentDark(0.72)
                }):Play()
                TweenService:Create(selectorStroke, TweenTable["selector"], {
                    Color = library.accentColor,
                    Transparency = 0.28
                }):Play()
                if selectorGlow then
                    TweenService:Create(selectorGlow, TweenTable["selector"], {ImageTransparency = 0.84}):Play()
                end
                if popupGlow then
                    TweenService:Create(popupGlow, TweenTable["selector_drop"], {ImageTransparency = 0.90}):Play()
                end
            end

            selector.MouseButton1Click:Connect(function()
                if selectorOpen then collapseSelector() else expandSelector() end
            end)

            selector.MouseEnter:Connect(function()
                if not selectorOpen then
                    TweenService:Create(selectorStroke, TweenTable["hover"], {
                        Color = library.accentSoft,
                        Transparency = 0.58
                    }):Play()
                    TweenService:Create(selectorTwo, TweenTable["hover"], {
                        BackgroundColor3 = library.inputHoverColor
                    }):Play()
                    if selectorGlow then
                        TweenService:Create(selectorGlow, TweenTable["hover"], {ImageTransparency = 0.95}):Play()
                    end
                end
            end)

            selector.MouseLeave:Connect(function()
                if not selectorOpen then
                    TweenService:Create(selectorStroke, TweenTable["hover"], {
                        Color = library.strokeColor,
                        Transparency = 0.60
                    }):Play()
                    TweenService:Create(selectorTwo, TweenTable["hover"], {
                        BackgroundColor3 = library.inputColor
                    }):Play()
                    if selectorGlow then
                        TweenService:Create(selectorGlow, TweenTable["hover"], {ImageTransparency = 1}):Play()
                    end
                end
            end)

            local function recolorOptions()
                for _, button in ipairs(optionButtons()) do
                    local selected = button.Text == selectorText.Text
                    button.TextColor3 = selected and library.accentColor or library.textSecondary
                    button.BackgroundTransparency = 1
                end
            end

            local function hookOptionClick(optionButton)
                optionButton.MouseEnter:Connect(function()
                    TweenService:Create(optionButton, TweenTable["hover"], {
                        BackgroundTransparency = 0.35,
                        TextColor3 = optionButton.Text == selectorText.Text and library.accentColor or library.textPrimary
                    }):Play()
                end)
                optionButton.MouseLeave:Connect(function()
                    TweenService:Create(optionButton, TweenTable["hover"], {
                        BackgroundTransparency = 1,
                        TextColor3 = optionButton.Text == selectorText.Text and library.accentColor or library.textSecondary
                    }):Play()
                end)
                optionButton.MouseButton1Click:Connect(function()
                    selectorText.Text = optionButton.Text
                    recolorOptions()
                    pcall(function() callback(optionButton.Text) end)
                    collapseSelector()
                end)
            end

            local function createOption(value)
                local optionButton = Instance.new("TextButton")
                optionButton.Name = "optionButton"
                optionButton.Parent = selectorContainer
                optionButton.BackgroundColor3 = library.surfaceHoverColor
                optionButton.BackgroundTransparency = 1
                optionButton.Size = UDim2.new(1, -2, 0, optionH)
                optionButton.AutoButtonColor = false
                optionButton.Font = Enum.Font.Gotham
                optionButton.Text = tostring(value)
                optionButton.TextColor3 = library.textSecondary
                optionButton.TextSize = 12
                optionButton.TextXAlignment = Enum.TextXAlignment.Left
                optionButton.ZIndex = popupZ + 1

                local optionPadding = Instance.new("UIPadding")
                optionPadding.Parent = optionButton
                optionPadding.PaddingLeft = UDim.new(0, 9)
                optionPadding.PaddingRight = UDim.new(0, 7)

                local optionCorner = Instance.new("UICorner")
                optionCorner.CornerRadius = UDim.new(0, 6)
                optionCorner.Parent = optionButton

                hookOptionClick(optionButton)
                return optionButton
            end

            for _, v in next, list do
                local optionButton = createOption(v)
                if optionButton.Text == tostring(default) then
                    optionButton.TextColor3 = library.accentColor
                    pcall(function() callback(selectorText.Text) end)
                end
            end

            refreshPopupGeometry()
            recolorOptions()
            UpdatePageSize()

            local SelectorFunctions = {}
            function SelectorFunctions:AddOption(new, callback_f)
                new = new or "option"
                table.insert(list, new)
                local optionButton = createOption(new)
                if callback_f then
                    optionButton.MouseButton1Click:Connect(function()
                        pcall(callback_f, optionButton.Text)
                    end)
                end
                refreshPopupGeometry()
                recolorOptions()
                if selectorOpen then
                    local h = refreshPopupGeometry()
                    selectorContainer.Size = UDim2.new(0, dropW, 0, h)
                    popupGlowHost.Size = UDim2.new(0, dropW, 0, h)
                end
                return SelectorFunctions
            end
            --
            function SelectorFunctions:RemoveOption(option)
                local target = tostring(option)
                for i = #list, 1, -1 do
                    if tostring(list[i]) == target then
                        table.remove(list, i)
                    end
                end
                for _, v in ipairs(optionButtons()) do
                    if v.Text == target then
                        v:Destroy()
                        break
                    end
                end
                if selectorText.Text == target then
                    selectorText.Text = ". . ."
                end
                task.defer(function()
                    refreshPopupGeometry()
                    recolorOptions()
                    if selectorOpen then
                        local h = refreshPopupGeometry()
                        selectorContainer.Size = UDim2.new(0, dropW, 0, h)
                        popupGlowHost.Size = UDim2.new(0, dropW, 0, h)
                    end
                end)
                return SelectorFunctions
            end
            --
            function SelectorFunctions:SetFunction(new)
                callback = new or callback
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Text(new)
                selectorLabel.Text = new or selectorLabel.Text
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Hide()
                collapseSelector()
                selectorFrame.Visible = false
                UpdatePageSize()
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Show()
                selectorFrame.Visible = true
                UpdatePageSize()
                return SelectorFunctions
            end
            --
            function SelectorFunctions:Remove()
                collapseSelector()
                selectorFrame:Destroy()
                UpdatePageSize()
                return SelectorFunctions
            end
            function SelectorFunctions:SetOption(option)
                local wanted = tostring(option)
                for _, child in ipairs(optionButtons()) do
                    if child.Text == wanted then
                        selectorText.Text = wanted
                        recolorOptions()
                        pcall(function() callback(wanted) end)
                        break
                    end
                end
                return SelectorFunctions
            end
            function SelectorFunctions:GetOption()
                return selectorText.Text
            end
            function SelectorFunctions:Flag(name)
                library:RegisterFlag(name, function() return selectorText.Text end, function(v) SelectorFunctions:SetOption(v) end, "selector")
                return SelectorFunctions
            end
            return SelectorFunctions
        end
        --
        function Components:NewSlider(text, suffix, compare, compareSign, values, callback)
            self._lastComponentType = "other"
            self._lastToggleRecord = nil
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize

            text = text or "slider"
            suffix = suffix or ""
            compare = compare or false
            compareSign = compareSign or "/"
            values = values or {}
            callback = callback or function() end

            local minValue = tonumber(values.min) or 0
            local maxValue = tonumber(values.max) or 100
            local ValueNum = tonumber(values.default)
            if ValueNum == nil then ValueNum = minValue end
            local step = tonumber(values.step)

            if maxValue < minValue then
                minValue, maxValue = maxValue, minValue
            end
            ValueNum = math.clamp(ValueNum, minValue, maxValue)

            -- A slider is deliberately split into two isolated bands:
            --  0..22  = label/value
            -- 28..50  = hit target + rail
            -- No UIListLayout is parented to either band, so nothing can
            -- silently override the rail/thumb positions.
            local sliderFrame = Instance.new("Frame")
            sliderFrame.Name = "sliderFrame"
            sliderFrame.Parent = page
            sliderFrame.BackgroundTransparency = 1
            sliderFrame.ClipsDescendants = false
            sliderFrame.Size = UDim2.new(0, _w, 0, 54)

            local sliderLabel = Instance.new("TextLabel")
            sliderLabel.Name = "sliderLabel"
            sliderLabel.Parent = sliderFrame
            sliderLabel.BackgroundTransparency = 1
            sliderLabel.Position = UDim2.new(0, 10, 0, 0)
            sliderLabel.Size = UDim2.new(1, -142, 0, 22)
            sliderLabel.Font = Enum.Font.Gotham
            sliderLabel.Text = text
            sliderLabel.TextColor3 = library.textSecondary
            sliderLabel.TextSize = 13
            sliderLabel.TextXAlignment = Enum.TextXAlignment.Left
            sliderLabel.TextYAlignment = Enum.TextYAlignment.Center
            sliderLabel.TextWrapped = false
            sliderLabel.TextTruncate = Enum.TextTruncate.AtEnd
            sliderLabel.ClipsDescendants = false
            sliderLabel.RichText = false

            local sliderValue = Instance.new("TextLabel")
            sliderValue.Name = "sliderValue"
            sliderValue.Parent = sliderFrame
            sliderValue.BackgroundTransparency = 1
            sliderValue.AnchorPoint = Vector2.new(1, 0)
            sliderValue.Position = UDim2.new(1, -10, 0, 0)
            sliderValue.Size = UDim2.new(0, 116, 0, 22)
            sliderValue.Font = Enum.Font.GothamSemibold
            sliderValue.TextColor3 = library.accentColor
            sliderValue.TextSize = 12
            sliderValue.TextXAlignment = Enum.TextXAlignment.Right
            sliderValue.TextYAlignment = Enum.TextYAlignment.Center

            local hit = Instance.new("TextButton")
            hit.Name = "sliderHitTarget"
            hit.Parent = sliderFrame
            hit.BackgroundTransparency = 1
            hit.Position = UDim2.new(0, 8, 0, 27)
            hit.Size = UDim2.new(1, -16, 0, 24)
            hit.AutoButtonColor = false
            hit.Text = ""
            hit.ZIndex = 5

            local rail = Instance.new("Frame")
            rail.Name = "sliderBackground"
            rail.Parent = hit
            rail.AnchorPoint = Vector2.new(0, 0.5)
            rail.BackgroundColor3 = Color3.fromRGB(31, 32, 42)
            rail.BorderSizePixel = 0
            rail.Position = UDim2.new(0, 3, 0.5, 0)
            rail.Size = UDim2.new(1, -6, 0, 4)
            rail.ClipsDescendants = false
            rail.ZIndex = 5

            local railCorner = Instance.new("UICorner")
            railCorner.CornerRadius = UDim.new(1, 0)
            railCorner.Parent = rail

            local railStroke = Instance.new("UIStroke")
            railStroke.Name = "sliderRailStroke"
            railStroke.Parent = rail
            railStroke.Color = library.strokeColor
            railStroke.Transparency = 0.65
            railStroke.Thickness = 1

            local railGradient = Instance.new("UIGradient")
            railGradient.Name = "sliderBackgroundGradient"
            railGradient.Parent = rail
            railGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 41, 52)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(27, 28, 37))
            }
            railGradient.Rotation = 90

            local fill = Instance.new("Frame")
            fill.Name = "sliderIndicator"
            fill.Parent = rail
            fill.BackgroundColor3 = library.accentColor
            fill.BorderSizePixel = 0
            fill.Position = UDim2.new(0, 0, 0, 0)
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.ZIndex = 6

            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(1, 0)
            fillCorner.Parent = fill

            local fillGradient = Instance.new("UIGradient")
            fillGradient.Name = "sliderIndicatorGradient"
            fillGradient.Parent = fill
            fillGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, library.accentColor),
                ColorSequenceKeypoint.new(1, library.gradientEnabled and library.accentColorBottom or library.accentColor)
            }

            local fillStroke = Instance.new("UIStroke")
            fillStroke.Name = "sliderIndicatorGlow"
            fillStroke.Parent = fill
            fillStroke.Color = library.accentColor
            fillStroke.Transparency = 0.62
            fillStroke.Thickness = 1.5

            local thumb = Instance.new("Frame")
            thumb.Name = "sliderThumb"
            thumb.Parent = hit
            thumb.AnchorPoint = Vector2.new(0.5, 0.5)
            thumb.BackgroundColor3 = Color3.fromRGB(242, 237, 255)
            thumb.BorderSizePixel = 0
            thumb.Position = UDim2.new(0, 8, 0.5, 0)
            thumb.Size = UDim2.new(0, 12, 0, 12)
            thumb.ZIndex = 9

            local thumbCorner = Instance.new("UICorner")
            thumbCorner.CornerRadius = UDim.new(1, 0)
            thumbCorner.Parent = thumb

            local thumbStroke = Instance.new("UIStroke")
            thumbStroke.Name = "sliderThumbStroke"
            thumbStroke.Parent = thumb
            thumbStroke.Color = library.accentColor
            thumbStroke.Transparency = 0.12
            thumbStroke.Thickness = 1.5

            local thumbGlow = library:AddSoftGlow(thumb, 0.76, 10, library.accentColor, 4)

            local function decimalsForStep()
                if not step then return nil end
                local s = tostring(step)
                local dec = s:match("%.(%d+)")
                return dec and #dec or nil
            end
            local stepDecimals = decimalsForStep()

            local function quantize(v)
                v = math.clamp(v, minValue, maxValue)
                if step and step > 0 then
                    v = minValue + math.floor(((v - minValue) / step) + 0.5) * step
                    v = math.clamp(v, minValue, maxValue)
                    if stepDecimals then
                        v = tonumber(string.format("%." .. stepDecimals .. "f", v))
                    end
                else
                    v = math.floor(v + 0.5)
                end
                return v
            end

            local function displayValue(v)
                if compare then
                    return tostring(v) .. compareSign .. tostring(maxValue) .. suffix
                end
                return tostring(v) .. suffix
            end

            local THUMB_RADIUS = 6
            local function railGeometry()
                local railWidth = rail.AbsoluteSize.X
                if railWidth <= 1 then railWidth = math.max(_w - 6, 1) end
                local leftX = rail.Position.X.Offset + THUMB_RADIUS
                local usable = math.max(railWidth - (THUMB_RADIUS * 2), 1)
                return railWidth, leftX, usable
            end

            local function ratioForValue(v)
                local span = maxValue - minValue
                if span <= 0 then return 0 end
                return math.clamp((v - minValue) / span, 0, 1)
            end

            local function render(animated)
                local ratio = ratioForValue(ValueNum)
                local railWidth, leftX, usable = railGeometry()
                local thumbX = leftX + ratio * usable
                -- Fill ends at thumb center, while thumb itself is clamped inside
                -- the rail endpoints by THUMB_RADIUS on both sides.
                local fillWidth = math.clamp(thumbX - rail.Position.X.Offset, 0, railWidth)
                local targetFill = UDim2.new(0, fillWidth, 1, 0)
                local targetThumb = UDim2.new(0, thumbX, 0.5, 0)
                sliderValue.Text = displayValue(ValueNum)

                if animated then
                    TweenService:Create(fill, TweenInfo.new(0.055, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetFill}):Play()
                    TweenService:Create(thumb, TweenInfo.new(0.055, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetThumb}):Play()
                else
                    fill.Size = targetFill
                    thumb.Position = targetThumb
                end
            end

            local sliding = false
            local function setFromScreenX(screenX, fireCallback)
                local railWidth = rail.AbsoluteSize.X
                if railWidth <= 1 then return end
                local localX = screenX - rail.AbsolutePosition.X
                local usable = math.max(railWidth - (THUMB_RADIUS * 2), 1)
                local ratio = math.clamp((localX - THUMB_RADIUS) / usable, 0, 1)
                local newValue = minValue + ratio * (maxValue - minValue)
                ValueNum = quantize(newValue)
                render(false)
                if fireCallback then
                    pcall(function() callback(ValueNum) end)
                end
            end

            hit.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    TweenService:Create(thumb, TweenTable["hover"], {Size = UDim2.new(0, 14, 0, 14)}):Play()
                    TweenService:Create(railStroke, TweenTable["hover"], {Color = library.accentSoft, Transparency = 0.42}):Play()
                    if thumbGlow then TweenService:Create(thumbGlow, TweenTable["hover"], {ImageTransparency = 0.60}):Play() end
                    setFromScreenX(inp.Position.X, true)
                end
            end)

            hit.MouseEnter:Connect(function()
                TweenService:Create(sliderLabel, TweenTable["hover"], {TextColor3 = library.textPrimary}):Play()
                TweenService:Create(railStroke, TweenTable["hover"], {Color = library.accentSoft, Transparency = 0.48}):Play()
            end)

            hit.MouseLeave:Connect(function()
                TweenService:Create(sliderLabel, TweenTable["hover"], {TextColor3 = library.textSecondary}):Play()
                if not sliding then
                    TweenService:Create(railStroke, TweenTable["hover"], {Color = library.strokeColor, Transparency = 0.65}):Play()
                end
            end)

            table.insert(library._connections, UserInputService.InputChanged:Connect(function(inp)
                if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    setFromScreenX(inp.Position.X, true)
                end
            end))

            table.insert(library._connections, UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    if sliding then
                        sliding = false
                        TweenService:Create(thumb, TweenTable["hover"], {Size = UDim2.new(0, 12, 0, 12)}):Play()
                        TweenService:Create(railStroke, TweenTable["hover"], {Color = library.strokeColor, Transparency = 0.65}):Play()
                        if thumbGlow then TweenService:Create(thumbGlow, TweenTable["hover"], {ImageTransparency = 0.76}):Play() end
                    end
                end
            end))

            rail:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                if rail.AbsoluteSize.X > 1 then render(false) end
            end)
            task.defer(function() render(false) end)

            UpdatePageSize()

            local SliderFunctions = {}
            function SliderFunctions:Value(new)
                local n = tonumber(new)
                if n ~= nil then
                    ValueNum = quantize(n)
                    render(false)
                end
                return SliderFunctions
            end
            function SliderFunctions:Max(new)
                local n = tonumber(new)
                if n ~= nil then
                    maxValue = n
                    if maxValue < minValue then maxValue = minValue end
                    ValueNum = math.clamp(ValueNum, minValue, maxValue)
                    render(false)
                end
                return SliderFunctions
            end
            function SliderFunctions:Min(new)
                local n = tonumber(new)
                if n ~= nil then
                    minValue = n
                    if minValue > maxValue then minValue = maxValue end
                    ValueNum = math.clamp(ValueNum, minValue, maxValue)
                    render(false)
                end
                return SliderFunctions
            end
            function SliderFunctions:SetFunction(new)
                callback = new or callback
                return SliderFunctions
            end
            function SliderFunctions:Text(new)
                sliderLabel.Text = new or sliderLabel.Text
                return SliderFunctions
            end
            function SliderFunctions:Hide()
                sliderFrame.Visible = false
                UpdatePageSize()
                return SliderFunctions
            end
            function SliderFunctions:Show()
                sliderFrame.Visible = true
                UpdatePageSize()
                return SliderFunctions
            end
            function SliderFunctions:Remove()
                sliderFrame:Destroy()
                UpdatePageSize()
                return SliderFunctions
            end
            function SliderFunctions:Flag(name)
                if not name then return SliderFunctions end
                library._flags[name] = SliderFunctions
                return SliderFunctions
            end
            return SliderFunctions
        end

        function Components:NewColorPicker(text, default, callback)
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            local screen = self._screen
            text = text or "Color Picker"
            default = default or Color3.fromRGB(255, 255, 255)
            callback = callback or function() end

            local currentColor = default
            local cpH, cpS, cpV = Color3.toHSV(default)

            local function _pairName(v)
                local n = tostring(v or ""):lower()
                n = n:gsub("enabled?", "")
                n = n:gsub("colour", "")
                n = n:gsub("color", "")
                n = n:gsub("esp", "")
                n = n:gsub("[^%w]", "")
                return n
            end
            local pairRecord = nil
            if self._lastComponentType == "toggle" and self._lastToggleRecord then
                local tr = self._lastToggleRecord
                local a, b = _pairName(tr.text), _pairName(text)
                local related = tr.colorCount > 0
                    or (a ~= "" and b ~= "" and (a == b or a:find(b, 1, true) or b:find(a, 1, true)))
                if related then pairRecord = tr end
            end
            local pickerOpen = false
            local svSize = 200
            local hueBarWidth = 16
            local popupW = svSize + hueBarWidth + 24
            local popupH = svSize + 16

            local cpFrame = Instance.new("Frame")
            cpFrame.Name = "colorPickerFrame"
            cpFrame.Parent = pairRecord and pairRecord.colorRow or page
            cpFrame.BackgroundTransparency = 1
            cpFrame.Size = pairRecord and UDim2.new(0, 22, 0, 20) or UDim2.new(0, _w, 0, 22)
            cpFrame.ClipsDescendants = false
            if pairRecord then
                pairRecord.activate()
                pairRecord.colorCount = pairRecord.colorCount + 1
            else
                self._lastComponentType = "other"
                self._lastToggleRecord = nil
            end

            local cpLabel = Instance.new("TextLabel")
            cpLabel.Name = "cpLabel"
            cpLabel.Parent = cpFrame
            cpLabel.BackgroundTransparency = 1
            cpLabel.Size = pairRecord and UDim2.new(0, 0, 0, 0) or UDim2.new(1, -42, 0, 22)
            cpLabel.Visible = not pairRecord
            cpLabel.Font = Enum.Font.Gotham
            cpLabel.Text = text
            cpLabel.TextColor3 = library.textSecondary
            cpLabel.TextSize = 12
            cpLabel.TextXAlignment = Enum.TextXAlignment.Left
            cpLabel.RichText = true
            local cpLabelPad = Instance.new("UIPadding")
            cpLabelPad.Parent = cpLabel
            cpLabelPad.PaddingLeft = UDim.new(0, 2)

            local preview = Instance.new("TextButton")
            preview.Name = "colorPreview"
            preview.Parent = cpFrame
            preview.Position = pairRecord and UDim2.new(0, 1, 0, 1) or UDim2.new(1, -24, 0, 2)
            preview.Size = UDim2.new(0, 18, 0, 18)
            preview.BackgroundColor3 = currentColor
            preview.BorderSizePixel = 0
            preview.AutoButtonColor = false
            preview.Text = ""
            local previewEdge = Instance.new("UIStroke")
            previewEdge.Color = library.accentSoft
            previewEdge.Thickness = 1.25
            previewEdge.Parent = preview
            local previewCorner = Instance.new("UICorner")
            previewCorner.CornerRadius = UDim.new(0, 5)
            previewCorner.Parent = preview

            local popup = Instance.new("Frame")
            popup.Name = "cpPopup"
            popup.Parent = screen
            popup.Size = UDim2.new(0, popupW, 0, popupH)
            popup.BackgroundColor3 = library.surfaceColor
            popup.BorderSizePixel = 0
            popup.Visible = false
            popup.ZIndex = 100
            local popupCorner = Instance.new("UICorner")
            popupCorner.CornerRadius = UDim.new(0, 10)
            popupCorner.Parent = popup
            local popupStroke = Instance.new("UIStroke")
            popupStroke.Color = library.accentSoft
            popupStroke.Thickness = 1
            popupStroke.Parent = popup

            local svFrame = Instance.new("ImageLabel")
            svFrame.Name = "svSquare"
            svFrame.Parent = popup
            svFrame.Position = UDim2.new(0, 8, 0, 8)
            svFrame.Size = UDim2.new(0, svSize, 0, svSize)
            svFrame.BackgroundColor3 = Color3.fromHSV(cpH, 1, 1)
            svFrame.BorderSizePixel = 0
            svFrame.ClipsDescendants = true
            svFrame.Image = "rbxassetid://4155801252"
            svFrame.ImageTransparency = 0
            svFrame.ScaleType = Enum.ScaleType.Stretch
            svFrame.Active = true
            svFrame.ZIndex = 101
            local svStroke = Instance.new("UIStroke")
            svStroke.Color = Color3.fromRGB(60, 60, 60)
            svStroke.Thickness = 1
            svStroke.Parent = svFrame

            local svCursor = Instance.new("Frame")
            svCursor.Name = "svCursor"
            svCursor.Parent = svFrame
            svCursor.Size = UDim2.new(0, 6, 0, 6)
            svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
            svCursor.Position = UDim2.new(cpS, 0, 1 - cpV, 0)
            svCursor.BackgroundColor3 = Color3.new(1, 1, 1)
            svCursor.BorderSizePixel = 0
            svCursor.ZIndex = 105
            local svCursorCorner = Instance.new("UICorner")
            svCursorCorner.CornerRadius = UDim.new(1, 0)
            svCursorCorner.Parent = svCursor
            local svCursorStroke = Instance.new("UIStroke")
            svCursorStroke.Color = Color3.new(0, 0, 0)
            svCursorStroke.Thickness = 1
            svCursorStroke.Parent = svCursor

            local hueBar = Instance.new("Frame")
            hueBar.Name = "hueBar"
            hueBar.Parent = popup
            hueBar.Position = UDim2.new(0, 8 + svSize + 8, 0, 8)
            hueBar.Size = UDim2.new(0, hueBarWidth, 0, svSize)
            hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
            hueBar.BorderSizePixel = 0
            hueBar.ClipsDescendants = true
            hueBar.Active = true
            hueBar.ZIndex = 101
            local hueStroke = Instance.new("UIStroke")
            hueStroke.Color = Color3.fromRGB(60, 60, 60)
            hueStroke.Thickness = 1
            hueStroke.Parent = hueBar

            local hueKeypoints = {}
            for i = 0, 1, 0.1 do
                table.insert(hueKeypoints, ColorSequenceKeypoint.new(math.clamp(i, 0, 1), Color3.fromHSV(math.clamp(i, 0, 1), 1, 1)))
            end
            local hueGrad = Instance.new("UIGradient")
            hueGrad.Color = ColorSequence.new(hueKeypoints)
            hueGrad.Rotation = 90
            hueGrad.Parent = hueBar

            local hueCursor = Instance.new("Frame")
            hueCursor.Name = "hueCursor"
            hueCursor.Parent = hueBar
            hueCursor.Size = UDim2.new(1, 4, 0, 3)
            hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
            hueCursor.Position = UDim2.new(0.5, 0, cpH, 0)
            hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
            hueCursor.BorderSizePixel = 0
            hueCursor.ZIndex = 105
            local hueCursorStroke = Instance.new("UIStroke")
            hueCursorStroke.Color = Color3.new(0, 0, 0)
            hueCursorStroke.Thickness = 1
            hueCursorStroke.Parent = hueCursor

            local function updateCPColor()
                currentColor = Color3.fromHSV(cpH, cpS, cpV)
                preview.BackgroundColor3 = currentColor
                svFrame.BackgroundColor3 = Color3.fromHSV(cpH, 1, 1)
                svCursor.Position = UDim2.new(cpS, 0, 1 - cpV, 0)
                hueCursor.Position = UDim2.new(0.5, 0, cpH, 0)
                pcall(function() callback(currentColor) end)
            end

            local function positionPopup()
                local px = preview.AbsolutePosition.X - popupW - 4
                local py = preview.AbsolutePosition.Y
                local viewportSize = workspace.CurrentCamera.ViewportSize
                if px < 0 then px = preview.AbsolutePosition.X + 22 end
                if py + popupH > viewportSize.Y then py = viewportSize.Y - popupH - 4 end
                popup.Position = UDim2.new(0, px, 0, py)
            end

            local function closePopup()
                if not pickerOpen then return end
                pickerOpen = false
                popup.Visible = false
                _popupActive = false
                if library._closeActivePopup == closePopup then
                    library._closeActivePopup = nil
                end
            end

            preview.MouseButton1Click:Connect(function()
                if pickerOpen then
                    closePopup()
                else
                    if library._closeActivePopup then
                        library._closeActivePopup()
                    end
                    positionPopup()
                    popup.Visible = true
                    pickerOpen = true
                    _popupActive = true
                    library._closeActivePopup = closePopup
                end
            end)

            table.insert(library._connections, UserInputService.InputBegan:Connect(function(inp)
                if not pickerOpen then return end
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    local pos = inp.Position
                    local pAbs = popup.AbsolutePosition
                    local pSize = popup.AbsoluteSize
                    if pos.X < pAbs.X or pos.X > pAbs.X + pSize.X or pos.Y < pAbs.Y or pos.Y > pAbs.Y + pSize.Y then
                        local prAbs = preview.AbsolutePosition
                        local prSize = preview.AbsoluteSize
                        if pos.X < prAbs.X or pos.X > prAbs.X + prSize.X or pos.Y < prAbs.Y or pos.Y > prAbs.Y + prSize.Y then
                            closePopup()
                        end
                    end
                end
            end))

            svFrame.InputBegan:Connect(function(inp)
                if not pickerOpen then return end
                if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
                while pickerOpen and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    local absPos = svFrame.AbsolutePosition
                    local absSize = svFrame.AbsoluteSize
                    cpS = math.clamp((Mouse.X - absPos.X) / absSize.X, 0, 1)
                    cpV = 1 - math.clamp((Mouse.Y - absPos.Y) / absSize.Y, 0, 1)
                    updateCPColor()
                    RunService.RenderStepped:Wait()
                end
            end)

            hueBar.InputBegan:Connect(function(inp)
                if not pickerOpen then return end
                if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
                while pickerOpen and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    local absPos = hueBar.AbsolutePosition
                    local absSize = hueBar.AbsoluteSize
                    cpH = math.clamp((Mouse.Y - absPos.Y) / absSize.Y, 0, 1)
                    updateCPColor()
                    RunService.RenderStepped:Wait()
                end
            end)

            UpdatePageSize()

            local CPFunctions = {}
            function CPFunctions:SetColor(color)
                cpH, cpS, cpV = Color3.toHSV(color)
                currentColor = color
                preview.BackgroundColor3 = color
                svFrame.BackgroundColor3 = Color3.fromHSV(cpH, 1, 1)
                svCursor.Position = UDim2.new(cpS, 0, 1 - cpV, 0)
                hueCursor.Position = UDim2.new(0.5, 0, cpH, 0)
                return CPFunctions
            end
            function CPFunctions:GetColor()
                return currentColor
            end
            function CPFunctions:Text(new)
                cpLabel.Text = new or text
                return CPFunctions
            end
            function CPFunctions:SetFunction(new)
                callback = new or callback
                return CPFunctions
            end
            function CPFunctions:Hide()
                cpFrame.Visible = false
                return CPFunctions
            end
            function CPFunctions:Show()
                cpFrame.Visible = true
                return CPFunctions
            end
            function CPFunctions:Remove()
                cpFrame:Destroy()
                popup:Destroy()
                return CPFunctions
            end
            function CPFunctions:Flag(name)
                library:RegisterFlag(name, function() return currentColor end, function(val) CPFunctions:SetColor(val); pcall(function() callback(val) end) end, "color")
                return CPFunctions
            end
            return CPFunctions
        end
