            if _groupRow then return end
            _groupRow = Instance.new("Frame")
            _groupRow.Name = "groupRow"
            _groupRow.Parent = page
            _groupRow.BackgroundTransparency = 1
            _groupRow.Size = UDim2.new(0, _baseW, 0, 0)
            _groupRow.AutomaticSize = Enum.AutomaticSize.Y
            _groupRow.ClipsDescendants = false

            local rowLayout = Instance.new("UIListLayout")
            rowLayout.Name = "rowLayout"
            rowLayout.Parent = _groupRow
            rowLayout.FillDirection = Enum.FillDirection.Horizontal
            rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
            rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
            rowLayout.Padding = UDim.new(0, 12)

            _leftColumn = Instance.new("Frame")
            _leftColumn.Name = "leftColumn"
            _leftColumn.Parent = _groupRow
            _leftColumn.BackgroundTransparency = 1
            _leftColumn.Size = UDim2.new(0, _groupColWidth, 0, 0)
            _leftColumn.AutomaticSize = Enum.AutomaticSize.Y
            _leftColumn.LayoutOrder = 1

            local leftLayout = Instance.new("UIListLayout")
            leftLayout.Parent = _leftColumn
            leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
            leftLayout.Padding = UDim.new(0, 12)

            _rightColumn = Instance.new("Frame")
            _rightColumn.Name = "rightColumn"
            _rightColumn.Parent = _groupRow
            _rightColumn.BackgroundTransparency = 1
            _rightColumn.Size = UDim2.new(0, _groupColWidth, 0, 0)
            _rightColumn.AutomaticSize = Enum.AutomaticSize.Y
            _rightColumn.LayoutOrder = 2

            local rightLayout = Instance.new("UIListLayout")
            rightLayout.Parent = _rightColumn
            rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
            rightLayout.Padding = UDim.new(0, 12)

            UpdatePageSize()
        end

        local function _createGroupbox(column, title)
            _ensureGroupRow()

            local gbFrame = Instance.new("Frame")
            gbFrame.Name = "groupbox_" .. title
            gbFrame.Parent = column
            gbFrame.BackgroundColor3 = library.surfaceColor
            gbFrame.Size = UDim2.new(1, 0, 0, 0)
            gbFrame.AutomaticSize = Enum.AutomaticSize.Y
            gbFrame.ClipsDescendants = false
            gbFrame.BorderSizePixel = 0

            local gbCorner = Instance.new("UICorner")
            gbCorner.CornerRadius = UDim.new(0, 12)
            gbCorner.Parent = gbFrame

            local gbGradient = Instance.new("UIGradient")
            gbGradient.Name = "groupboxGradient"
            gbGradient.Parent = gbFrame
            gbGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(22, 23, 32)),
                ColorSequenceKeypoint.new(0.52, Color3.fromRGB(19, 20, 28)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(16, 17, 24))
            }
            gbGradient.Rotation = 110

            local gbStroke = Instance.new("UIStroke")
            gbStroke.Color = library.strokeColor
            gbStroke.Transparency = 0.58
            gbStroke.Thickness = 1
            gbStroke.Parent = gbFrame

            local gbAccentStroke = Instance.new("UIStroke")
            gbAccentStroke.Name = "groupboxAmbientStroke"
            gbAccentStroke.Color = library.accentSoft
            gbAccentStroke.Transparency = 0.90
            gbAccentStroke.Thickness = 2
            gbAccentStroke.Parent = gbFrame

            -- Soft lavender light leaking into the card from its header.
            if library.glowAsset then
                local gbHeaderAura = Instance.new("ImageLabel")
                gbHeaderAura.Name = "groupboxHeaderAura"
                gbHeaderAura.Parent = gbFrame
                gbHeaderAura.BackgroundTransparency = 1
                gbHeaderAura.Image = library.glowAsset
                gbHeaderAura.ImageColor3 = library.accentColor
                gbHeaderAura.ImageTransparency = 0.885
                gbHeaderAura.ScaleType = Enum.ScaleType.Stretch
                gbHeaderAura.Position = UDim2.new(0, -54, 0, -52)
                gbHeaderAura.Size = UDim2.new(0, 220, 0, 145)
                gbHeaderAura.ZIndex = 1
                gbHeaderAura.Active = false
            end

            local gbIcon = Instance.new("ImageLabel")
            gbIcon.Name = "gbLucideIcon"
            gbIcon.Parent = gbFrame
            gbIcon.BackgroundTransparency = 1
            gbIcon.Size = UDim2.new(0, 14, 0, 14)
            gbIcon.Position = UDim2.new(0, 11, 0, 12)
            gbIcon.ImageColor3 = library.accentColor
            gbIcon.ImageTransparency = 0
            gbIcon.ScaleType = Enum.ScaleType.Fit
            local gbIconAsset = nil
            gbIcon.Visible = false

            local gbTitle = Instance.new("TextLabel")
            gbTitle.Name = "gbTitle"
            gbTitle.Parent = gbFrame
            gbTitle.BackgroundTransparency = 1
            gbTitle.Size = UDim2.new(1, -42, 0, 28)
            gbTitle.Position = UDim2.new(0, 11, 0, 5)
            gbTitle.Font = Enum.Font.GothamSemibold
            gbTitle.Text = string.upper(title)
            gbTitle.TextColor3 = library.accentColor
            gbTitle.TextSize = 10
            gbTitle.TextXAlignment = Enum.TextXAlignment.Left

            task.spawn(function()
                local asset = library:LoadLucideIcon(library:LucideForSection(title))
                if asset and gbFrame.Parent then
                    gbIconAsset = asset
                    gbIcon.Image = asset
                    gbIcon.Visible = true
                    gbTitle.Position = UDim2.new(0, 33, 0, 5)
                end
            end)

            local gbHeaderRule = Instance.new("Frame")
            gbHeaderRule.Name = "gbHeaderRule"
            gbHeaderRule.Parent = gbFrame
            gbHeaderRule.BackgroundColor3 = library.strokeColor
            gbHeaderRule.BackgroundTransparency = 0.78
            gbHeaderRule.BorderSizePixel = 0
            gbHeaderRule.Position = UDim2.new(0, 10, 0, 33)
            gbHeaderRule.Size = UDim2.new(1, -20, 0, 1)

            local gbContent = Instance.new("Frame")
            gbContent.Name = "gbContent"
            gbContent.Parent = gbFrame
            gbContent.BackgroundTransparency = 1
            gbContent.Position = UDim2.new(0, 0, 0, 38)
            gbContent.Size = UDim2.new(1, 0, 0, 0)
            gbContent.AutomaticSize = Enum.AutomaticSize.Y

            local gbContentLayout = Instance.new("UIListLayout")
            gbContentLayout.Parent = gbContent
            gbContentLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            gbContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
            gbContentLayout.Padding = UDim.new(0, 8)

            local gbPadding = Instance.new("UIPadding")
            gbPadding.Parent = gbContent
            gbPadding.PaddingBottom = UDim.new(0, 13)
            gbPadding.PaddingLeft = UDim.new(0, 12)
            gbPadding.PaddingRight = UDim.new(0, 12)
            gbPadding.PaddingTop = UDim.new(0, 6)

            local gbComponentWidth = _groupColWidth - 24
            local function gbUpdateSize()
                UpdatePageSize()
            end

            gbContent.ChildAdded:Connect(gbUpdateSize)
            gbContent.ChildRemoved:Connect(gbUpdateSize)

            local gbComponents = setmetatable({
                _page = gbContent,
                _width = gbComponentWidth,
                _updateSize = gbUpdateSize,
                _screen = screen,
                _groupTitle = title,
            }, {__index = Components})

            return gbComponents
        end

        function Components:AddLeftGroupbox(title)
            return _createGroupbox(_leftColumn or (function() _ensureGroupRow(); return _leftColumn end)(), title or "Group")
        end

        function Components:AddRightGroupbox(title)
            return _createGroupbox(_rightColumn or (function() _ensureGroupRow(); return _rightColumn end)(), title or "Group")
        end

        local function _createModule(column, title, subtabs)
            local gb = _createGroupbox(column, title)
            if subtabs and #subtabs > 0 then
                return gb:NewSubTabGroup(subtabs)
            end
            return gb
        end

        function Components:AddLeftModule(title, subtabs)
            _ensureGroupRow()
            return _createModule(_leftColumn, title or "Module", subtabs)
        end

        function Components:AddRightModule(title, subtabs)
            _ensureGroupRow()
            return _createModule(_rightColumn, title or "Module", subtabs)
        end
        --
        function Components:Open()
            TabLibrary.CurrentTab = title
            updateContentHeader(title)
            for _,v in pairs(container:GetChildren()) do 
                if v:IsA("ScrollingFrame") then
                    v.Visible = false
                end
            end
            page.Visible = true

            for _,v in pairs(tabButtons:GetChildren()) do
                if v:IsA("TextButton") then
                    TweenService:Create(v, TweenTable["tab_text_colour"], {
                        TextColor3 = library.textMuted,
                        BackgroundTransparency = 1
                    }):Play()
                    local t = v:FindFirstChild("tabText")
                    if t and t:IsA("TextLabel") then
                        TweenService:Create(t, TweenTable["tab_text_colour"], {TextColor3 = library.textMuted}):Play()
                    end
                    local s = v:FindFirstChild("tabStroke")
                    if s then TweenService:Create(s, TweenTable["tab_text_colour"], {Transparency = 1}):Play() end
                    local g = v:FindFirstChild("softGlow")
                    if g and g:IsA("ImageLabel") then TweenService:Create(g, TweenTable["tab_text_colour"], {ImageTransparency = 1}):Play() end
                    local i = v:FindFirstChild("tabLucideIcon")
                    if i and i:IsA("ImageLabel") and i.Visible then
                        TweenService:Create(i, TweenTable["tab_text_colour"], {
                            ImageColor3 = library.textMuted,
                            ImageTransparency = 0.12
                        }):Play()
                    end
                end
            end

            TweenService:Create(tabButton, TweenTable["tab_text_colour"], {
                TextColor3 = library.textPrimary,
                BackgroundTransparency = 0
            }):Play()
            TweenService:Create(tabText, TweenTable["tab_text_colour"], {TextColor3 = library.textPrimary}):Play()
            TweenService:Create(tabStroke, TweenTable["tab_text_colour"], {Transparency = 0.72}):Play()
            if tabGlow then TweenService:Create(tabGlow, TweenTable["tab_text_colour"], {ImageTransparency = 0.79}):Play() end
            if tabIcon.Visible then
                TweenService:Create(tabIcon, TweenTable["tab_text_colour"], {
                    ImageColor3 = library.accentColor,
                    ImageTransparency = 0
                }):Play()
            end
            moveIndicatorTo(tabButton)

            return Components
        end
        --
        function Components:Remove()
            tabButton:Destroy()
            page:Destroy()

            return Components
        end
        --
        function Components:Hide()
            tabButton.Visible = false
            page.Visible = false

            return Components
        end
        --
        function Components:Show()
            tabButton.Visible = true

            return Components
        end
        --
        function Components:Text(text)
            text = text or "new text"
            tabText.Text = text

            return Components
        end
        return Components
    end
    --
    function TabLibrary:Remove()
        screen:Destroy()

        return TabLibrary
    end
    --
    function TabLibrary:Text(text)
        text = text or "new text"
        headerProduct.Text = text
        contentKicker.Text = text

        return TabLibrary
    end
    --
    function TabLibrary:UpdateKeybind(new)
        new = new or key
        key = new
        return TabLibrary
    end
    library:Watermark("SKYFALL  •  " .. library.title .. "  •  v" .. library.version)

    local _skyfallCornerIcon = library:LoadIcon("https://raw.githubusercontent.com/skyfallHosting/skyfallUserInterface/main/CornerIcon.png", "skyfall_corner.png")
    if _skyfallCornerIcon then
        library:ImageWatermark(_skyfallCornerIcon, {
            corner = "bottomright",
            size = UDim2.new(0, 48, 0, 48),
            transparency = 0.3
        })
    end

    task.defer(function()
        local settingsTab = TabLibrary:NewTab("Settings")

        settingsTab:NewSection("Menu")
        local _mkLabel = settingsTab:NewLabel("Menu Key: " .. key.Name)
        settingsTab:NewButton("Change Menu Key", function()
            _mkLabel:Text("Menu Key: press any key...")
            local inp = UserInputService.InputBegan:Wait()
            if inp.KeyCode ~= Enum.KeyCode.Unknown then
                _mkLabel:Text("Menu Key: " .. inp.KeyCode.Name)
                TabLibrary:UpdateKeybind(inp.KeyCode)
            else
                _mkLabel:Text("Menu Key: " .. key.Name)
            end
        end)
        settingsTab:NewSeperator()

        settingsTab:NewSection("Theme")
        settingsTab:NewToggle("Gradient", library.gradientEnabled, function(v)
            library.gradientEnabled = v
            library:ApplyTheme()
        end):Flag("_GradientEnabled")
        settingsTab:NewColorPicker("Top Accent Color", library.accentColor, function(color)
            library:SetAccentColor(color)
            library:ApplyTheme()
        end):Flag("_AccentTop")
        settingsTab:NewColorPicker("Bottom Accent Color", library.accentColorBottom, function(color)
            library.accentColorBottom = color
            library:ApplyTheme()
        end):Flag("_AccentBottom")
        settingsTab:NewColorPicker("Background Color", library.bgColor, function(color)
            library.bgColor = color
            library:ApplyTheme()
        end):Flag("_BgColor")
        settingsTab:NewSeperator()

        settingsTab:NewSection("Watermarks")
        settingsTab:NewToggle("Corner Watermark", library._cornerWatermark ~= nil, function(v)
            if library._cornerWatermark then
                if v then library._cornerWatermark:Show() else library._cornerWatermark:Hide() end
            end
        end):Flag("_CornerWatermark")
        settingsTab:NewToggle("Tab Watermark", true, function(v)
            if library._watermark then
                if v then library._watermark:Show() else library._watermark:Hide() end
            end
        end):Flag("_TabWatermark")
        settingsTab:NewSeperator()

        settingsTab:NewSection("Actions")
        settingsTab:NewButton("Unload", function()
            library:Unload()
        end)

        local configsTab = TabLibrary:NewTab("Configs")
        library:BuildConfigSection(configsTab)
        task.defer(function()
            pcall(function() library:LoadAutoloadConfig() end)
        end)
    end)

    return TabLibrary
end

function library:RegisterFlag(name, getVal, setVal, flagType)
    self._flags[name] = {get = getVal, set = setVal, type = flagType}
end

function library:Notify(text, duration)
    if not self._notifier then
        self._notifier = self:InitNotifications()
    end
    pcall(function() self._notifier:Notify(text, duration or 3) end)
end

function library:SetConfigFolder(folder)
    self.configFolder = folder
end

function library:EnsureConfigFolder()
    local folder = self.configFolder
    pcall(function()
        local parts = {}
        for part in folder:gmatch("[^/\\]+") do
            table.insert(parts, part)
            local path = table.concat(parts, "/")
            if not isfolder(path) then makefolder(path) end
        end
    end)
end

function library:SaveConfig(name)
    self:EnsureConfigFolder()
    local data = {}
    for flag, entry in pairs(self._flags) do
        local ok, val = pcall(entry.get)
        if ok then
            if entry.type == "color" and typeof(val) == "Color3" then
                data[flag] = {_type = "Color3", R = math.floor(val.R * 255), G = math.floor(val.G * 255), B = math.floor(val.B * 255)}
            elseif entry.type == "selector" then
                data[flag] = {_type = "string", value = tostring(val)}
            else
                data[flag] = val
            end
        end
    end
    local json = game:GetService("HttpService"):JSONEncode(data)
    writefile(self.configFolder .. "/" .. name .. ".json", json)
end

function library:LoadConfig(name)
    local path = self.configFolder .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local ok, json = pcall(readfile, path)
    if not ok then return false end
    local ok2, data = pcall(function() return game:GetService("HttpService"):JSONDecode(json) end)
    if not ok2 or type(data) ~= "table" then return false end
    for flag, val in pairs(data) do
        local entry = self._flags[flag]
        if entry then
            pcall(function()
                if type(val) == "table" and val._type == "Color3" then
                    entry.set(Color3.fromRGB(val.R, val.G, val.B))
                elseif type(val) == "table" and val._type == "string" then
                    entry.set(val.value)
                else
                    entry.set(val)
                end
            end)
        end
    end
    return true
end

function library:GetAutoloadConfigPath()
    return self.configFolder .. "/autoload.txt"
end

function library:SetAutoloadConfig(name)
    if type(name) ~= "string" or name == "" then return false end
    if not isfile(self.configFolder .. "/" .. name .. ".json") then return false end
    self:EnsureConfigFolder()
    writefile(self:GetAutoloadConfigPath(), name)
    return true
end

function library:GetAutoloadConfig()
    local path = self:GetAutoloadConfigPath()
    if not isfile(path) then return nil end
    local ok, name = pcall(readfile, path)
    if not ok or type(name) ~= "string" or name == "" then return nil end
    return name
end

function library:ClearAutoloadConfig()
    local path = self:GetAutoloadConfigPath()
    if isfile(path) then delfile(path) end
    return true
end

function library:LoadAutoloadConfig()
    local name = self:GetAutoloadConfig()
    if not name then return false end
    return self:LoadConfig(name)
end

function library:DeleteConfig(name)
    local path = self.configFolder .. "/" .. name .. ".json"
    if isfile(path) then
        delfile(path)
        return true
    end
    return false
end

function library:ListConfigs()
    self:EnsureConfigFolder()
    local configs = {}
    local ok, files = pcall(listfiles, self.configFolder)
    if ok and files then
        for _, file in ipairs(files) do
            local name = file:match("([^/\\]+)%.json$")
            if name then table.insert(configs, name) end
        end
    end
    return configs
end

function library:BuildConfigSection(tab)
    tab:NewSection("Configuration")

    local configList = self:ListConfigs()
    local selectedConfig = configList[1] or ""
    local lastSource = "selector"

    local configSelector = tab:NewSelector("Config", selectedConfig, configList, function(v)
        selectedConfig = v
        lastSource = "selector"
    end)

    tab:NewTextbox("Config Name", false, "new config name", nil, nil, true, false, function(text)
        if text and text ~= "" then
            selectedConfig = text
            lastSource = "textbox"
        end
    end)

    local function ensureInList(name)
        for _, existing in ipairs(configList) do
            if existing == name then return end
        end
        configSelector:AddOption(name)
        table.insert(configList, name)
    end

    local function removeFromList(name)
        configSelector:RemoveOption(name)
        for i, v in ipairs(configList) do
            if v == name then table.remove(configList, i); break end
        end
    end

    tab:NewButton("Save Config", function()
        local name = selectedConfig
        if not name or name == "" then return end
        pcall(function() self:SaveConfig(name) end)
        ensureInList(name)
        configSelector:SetOption(name)
        selectedConfig = name
        pcall(function() self:Notify("Saved config: " .. name, 3) end)
    end)

    tab:NewButton("Load Config", function()
        local name = selectedConfig
        if not name or name == "" then return end
        local ok = pcall(function() return self:LoadConfig(name) end)
        pcall(function()
            self:Notify(ok and ("Loaded config: " .. name) or ("Failed to load: " .. name), 3)
        end)
    end)

    tab:NewButton("Set Config Autoload", function()
        local name = selectedConfig
        if not name or name == "" then return end
        local ok, saved = pcall(function() return self:SetAutoloadConfig(name) end)
        pcall(function()
            self:Notify(ok and saved and ("Autoload config set: " .. name) or "Failed to set autoload config", 3)
        end)
    end)

    tab:NewButton("Clear Config Autoload", function()
        local ok = pcall(function() self:ClearAutoloadConfig() end)
        pcall(function()
            self:Notify(ok and "Autoload config cleared" or "Failed to clear autoload config", 3)
        end)
    end)

    tab:NewButton("Delete Config", function()
        local name = selectedConfig
        if not name or name == "" then return end
        pcall(function() self:DeleteConfig(name) end)
        if self:GetAutoloadConfig() == name then
            pcall(function() self:ClearAutoloadConfig() end)
        end
        removeFromList(name)
        selectedConfig = configList[1] or ""
        if selectedConfig ~= "" then
            configSelector:SetOption(selectedConfig)
        end
        pcall(function() self:Notify("Deleted config: " .. name, 3) end)
    end)

    tab:NewButton("Refresh Configs", function()
        local ok, newList = pcall(function() return self:ListConfigs() end)
        if ok and newList then
            for _, name in ipairs(newList) do
                ensureInList(name)
            end
            configList = newList
        end
        pcall(function() self:Notify("Refreshed config list", 2) end)
    end)

    return configSelector
end

function library:Unload()
    for _, conn in ipairs(self._connections) do
        pcall(function() conn:Disconnect() end)
    end
    self._connections = {}

    for _, gui in ipairs(self._screenGuis) do
        pcall(function() gui:Destroy() end)
    end
    self._screenGuis = {}

    pcall(function()
        for _, v in ipairs(CoreGuiService:GetChildren()) do
            if v.Name == "watermark" or v.Name == "ImageWatermark" or v.Name == "screen" or v.Name == "notifications" then
                v:Destroy()
            end
        end
    end)

    pcall(function()
        if self._closeActivePopup then self._closeActivePopup() end
        self._closeActivePopup = nil
        if self._watermark then self._watermark = nil end
        if self._cornerWatermark then self._cornerWatermark = nil end
        if self._notifier then self._notifier = nil end
    end)

    if self._onUnload and type(self._onUnload) == "function" then
        pcall(self._onUnload)
    end

    for _, cb in ipairs(self._unloadCallbacks or {}) do
        pcall(cb)
    end

    self._flags = {}
end

function library:OnUnload(callback)
    if not self._unloadCallbacks then
        self._unloadCallbacks = {}
    end
    table.insert(self._unloadCallbacks, callback)
end

return library
