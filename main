    headerDivider.ZIndex = 6

    local function updateContentHeader(tabTitle)
        contentSubtitle.Text = library:TabSubtitle(tabTitle)
        contentTabPill.Text = string.upper(tostring(tabTitle or ""))
        local targetW = math.clamp(TextService:GetTextSize(contentTabPill.Text, 9, Enum.Font.GothamSemibold, Vector2.new(math.huge, 25)).X + 24, 54, 104)
        TweenService:Create(contentTabPill, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, targetW, 0, 25),
            Position = UDim2.new(1, -(targetW + 18), 0, 18)
        }):Play()
    end

    local tabIndicator = Instance.new("Frame")
    tabIndicator.Name = "tabIndicator"
    tabIndicator.Parent = tabButtonsEdge
    tabIndicator.BackgroundColor3 = library.accentColor
    tabIndicator.BorderSizePixel = 0
    tabIndicator.Size = UDim2.new(0, 3, 0, 24)
    tabIndicator.Position = UDim2.new(0, 5, 0, 12)
    tabIndicator.ZIndex = 5
    local tabIndicatorCorner = Instance.new("UICorner")
    tabIndicatorCorner.CornerRadius = UDim.new(1, 0)
    tabIndicatorCorner.Parent = tabIndicator
    local tabIndicatorGlowStroke = Instance.new("UIStroke")
    tabIndicatorGlowStroke.Color = library.accentColor
    tabIndicatorGlowStroke.Transparency = 0.30
    tabIndicatorGlowStroke.Thickness = 3
    tabIndicatorGlowStroke.Parent = tabIndicator

    CreateTween("tab_indicator", 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local function moveIndicatorTo(btn)
        local btnY = btn.AbsolutePosition.Y - tabButtonsEdge.AbsolutePosition.Y
        TweenService:Create(tabIndicator, TweenTable["tab_indicator"], {Position = UDim2.new(0, 5, 0, btnY + 6)}):Play()
    end

    local TabLibrary = {
        IsFirst = true,
        CurrentTab = ""
    }
    CreateTween("tab_text_colour", 0.16)
    function TabLibrary:NewTab(title)
        title = title or "tab"

        local tabButton = Instance.new("TextButton")
        local page = Instance.new("ScrollingFrame")
        local pageLayout = Instance.new("UIListLayout")
        local pagePadding = Instance.new("UIPadding")

        tabButton.Name = "tabButton"
        tabButton.Parent = tabButtons
        tabButton.BackgroundColor3 = Color3.fromRGB(31, 25, 46)
        tabButton.BackgroundTransparency = 1
        tabButton.ClipsDescendants = false
        tabButton.Size = UDim2.new(0, 168, 0, 38)
        tabButton.AutoButtonColor = false
        tabButton.Font = Enum.Font.GothamMedium
        tabButton.Text = ""
        tabButton.TextColor3 = library.textMuted
        tabButton.TextSize = 12
        tabButton.TextXAlignment = Enum.TextXAlignment.Left
        tabButton.RichText = true
        tabButton.ZIndex = 6

        -- v2.6: icons and labels live in separate fixed columns.  The old
        -- implementation indented TextButton.Text, which let Lucide images
        -- visually collide with the first characters at some UI scales.
        local tabText = Instance.new("TextLabel")
        tabText.Name = "tabText"
        tabText.Parent = tabButton
        tabText.BackgroundTransparency = 1
        tabText.Position = UDim2.new(0, 42, 0, 0)
        tabText.Size = UDim2.new(1, -50, 1, 0)
        tabText.Font = Enum.Font.GothamMedium
        tabText.Text = title
        tabText.TextColor3 = library.textMuted
        tabText.TextSize = 12
        tabText.TextXAlignment = Enum.TextXAlignment.Left
        tabText.TextYAlignment = Enum.TextYAlignment.Center
        tabText.TextTruncate = Enum.TextTruncate.AtEnd
        tabText.ZIndex = 8

        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 9)
        tabCorner.Parent = tabButton

        local tabStroke = Instance.new("UIStroke")
        tabStroke.Name = "tabStroke"
        tabStroke.Parent = tabButton
        tabStroke.Color = library.accentColor
        tabStroke.Transparency = 1
        tabStroke.Thickness = 1

        local tabGradient = Instance.new("UIGradient")
        tabGradient.Name = "tabGradient"
        tabGradient.Parent = tabButton
        tabGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(42, 31, 65)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(26, 23, 39))
        }
        tabGradient.Rotation = 0

        local tabGlow = library:AddSoftGlow(tabButton, 1, 13, library.accentColor, 4)

        local tabIcon = Instance.new("ImageLabel")
        tabIcon.Name = "tabLucideIcon"
        tabIcon.Parent = tabButton
        tabIcon.BackgroundTransparency = 1
        tabIcon.Position = UDim2.new(0, 16, 0.5, -8)
        tabIcon.Size = UDim2.new(0, 16, 0, 16)
        tabIcon.ImageColor3 = library.textMuted
        tabIcon.ImageTransparency = 0.12
        tabIcon.ScaleType = Enum.ScaleType.Fit
        tabIcon.ZIndex = 8
        local tabIconAsset = nil
        tabIcon.Visible = false

        -- Text is indented directly so child icons keep their true left position.
        local tabPad = nil

        task.spawn(function()
            local asset = library:LoadLucideIcon(library:LucideForTab(title))
            if asset and tabButton.Parent then
                tabIconAsset = asset
                tabIcon.Image = asset
                tabIcon.Visible = true
                -- no parent UIPadding here; it used to shift the icon into the label
                if TabLibrary.CurrentTab == title then
                    tabIcon.ImageColor3 = library.accentColor
                    tabIcon.ImageTransparency = 0
                else
                    tabIcon.ImageColor3 = library.textMuted
                    tabIcon.ImageTransparency = 0.12
                end
            end
        end)

        page.Name = "page"
        page.Parent = container
        page.Active = true
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.Position = UDim2.new(0, 0, 0, 62)
        page.Size = UDim2.new(0, 616, 0, 390)
        page.BottomImage = "http://www.roblox.com/asset/?id=3062506202"
        page.MidImage = "http://www.roblox.com/asset/?id=3062506202"
        page.ScrollBarThickness = 1
        page.TopImage = "http://www.roblox.com/asset/?id=3062506202"
        page.ScrollBarImageColor3 = accentDark(0.72)
        page.ScrollBarImageTransparency = 0.38
        page.Visible = false
        page.ZIndex = 5
        
        pageLayout.Name = "pageLayout"
        pageLayout.Parent = page
        pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Padding = UDim.new(0, 12)

        pagePadding.Name = "pagePadding"
        pagePadding.Parent = page
        pagePadding.PaddingBottom = UDim.new(0, 16)
        pagePadding.PaddingLeft = UDim.new(0, 16)
        pagePadding.PaddingRight = UDim.new(0, 16)
        pagePadding.PaddingTop = UDim.new(0, 16)

        if TabLibrary.IsFirst then
            page.Visible = true
            tabButton.TextColor3 = library.textPrimary
            tabText.TextColor3 = library.textPrimary
            tabButton.BackgroundTransparency = 0
            tabStroke.Transparency = 0.72
            if tabGlow then tabGlow.ImageTransparency = 0.79 end
            if tabIcon.Visible then
                tabIcon.ImageColor3 = library.accentColor
                tabIcon.ImageTransparency = 0
            end
            TabLibrary.CurrentTab = title
            updateContentHeader(title)
            task.defer(function() moveIndicatorTo(tabButton) end)
        end
        
        tabButton.MouseEnter:Connect(function()
            if TabLibrary.CurrentTab ~= title then
                TweenService:Create(tabButton, TweenTable["hover"], {
                    BackgroundTransparency = 0.62
                }):Play()
                TweenService:Create(tabText, TweenTable["hover"], {TextColor3 = library.textSecondary}):Play()
                TweenService:Create(tabStroke, TweenTable["hover"], {Transparency = 0.88}):Play()
                if tabGlow then TweenService:Create(tabGlow, TweenTable["hover"], {ImageTransparency = 0.93}):Play() end
                if tabIcon.Visible then
                    TweenService:Create(tabIcon, TweenTable["hover"], {
                        ImageColor3 = library.textSecondary,
                        ImageTransparency = 0
                    }):Play()
                end
            end
        end)
        tabButton.MouseLeave:Connect(function()
            if TabLibrary.CurrentTab ~= title then
                TweenService:Create(tabButton, TweenTable["hover"], {
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(tabText, TweenTable["hover"], {TextColor3 = library.textMuted}):Play()
                TweenService:Create(tabStroke, TweenTable["hover"], {Transparency = 1}):Play()
                if tabGlow then TweenService:Create(tabGlow, TweenTable["hover"], {ImageTransparency = 1}):Play() end
                if tabIcon.Visible then
                    TweenService:Create(tabIcon, TweenTable["hover"], {
                        ImageColor3 = library.textMuted,
                        ImageTransparency = 0.12
                    }):Play()
                end
            end
        end)

        tabButton.MouseButton1Click:Connect(function()
            if library._closeActivePopup then
                library._closeActivePopup()
            end
            TabLibrary.CurrentTab = title
            updateContentHeader(title)

            for _,v in pairs(container:GetChildren()) do
                if v:IsA("ScrollingFrame") then
                    v.Visible = false
                end
            end
            page.Visible = true

            for _,v in pairs(tabButtons:GetChildren()) do
                if v:IsA("TextButton") then
                    TweenService:Create(v, TweenTable["tab_text_colour"], {
                        TextColor3 = library.textMuted,
                        BackgroundTransparency = 1
                    }):Play()
                    local t = v:FindFirstChild("tabText")
                    if t and t:IsA("TextLabel") then
                        TweenService:Create(t, TweenTable["tab_text_colour"], {TextColor3 = library.textMuted}):Play()
                    end
                    local s = v:FindFirstChild("tabStroke")
                    if s then TweenService:Create(s, TweenTable["tab_text_colour"], {Transparency = 1}):Play() end
                    local g = v:FindFirstChild("softGlow")
                    if g and g:IsA("ImageLabel") then TweenService:Create(g, TweenTable["tab_text_colour"], {ImageTransparency = 1}):Play() end
                    local i = v:FindFirstChild("tabLucideIcon")
                    if i and i:IsA("ImageLabel") and i.Visible then
                        TweenService:Create(i, TweenTable["tab_text_colour"], {
                            ImageColor3 = library.textMuted,
                            ImageTransparency = 0.12
                        }):Play()
                    end
                end
            end

            TweenService:Create(tabButton, TweenTable["tab_text_colour"], {
                TextColor3 = library.textPrimary,
                BackgroundTransparency = 0
            }):Play()
            TweenService:Create(tabText, TweenTable["tab_text_colour"], {TextColor3 = library.textPrimary}):Play()
            TweenService:Create(tabStroke, TweenTable["tab_text_colour"], {Transparency = 0.72}):Play()
            if tabGlow then TweenService:Create(tabGlow, TweenTable["tab_text_colour"], {ImageTransparency = 0.79}):Play() end
            if tabIcon.Visible then
                TweenService:Create(tabIcon, TweenTable["tab_text_colour"], {
                    ImageColor3 = library.accentColor,
                    ImageTransparency = 0
                }):Play()
            end
            moveIndicatorTo(tabButton)
        end)

        local function UpdatePageSize()
            local correction = pageLayout.AbsoluteContentSize
            page.CanvasSize = UDim2.new(0, correction.X+13, 0, correction.Y+13)
        end

        page.ChildAdded:Connect(UpdatePageSize)
        page.ChildRemoved:Connect(UpdatePageSize)

        TabLibrary.IsFirst = false

        CreateTween("hover", 0.16)
        local Components = {}
        Components._page = page
        Components._width = 584
        Components._updateSize = UpdatePageSize
        Components._screen = screen
        function Components:NewLabel(text, alignment)
            self._lastComponentType = "other"
            self._lastToggleRecord = nil
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            text = text or "label"
            alignment = alignment or "left"

            local label = Instance.new("TextLabel")
            local labelPadding = Instance.new("UIPadding")

            label.Name = "label"
            label.Parent = page
            label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            label.BackgroundTransparency = 1.000
            label.Position = UDim2.new(0.00499999989, 0, 0, 0)
            label.Size = UDim2.new(0, _w, 0, 24)
            label.Font = Enum.Font.Gotham
            label.Text = text
            label.TextColor3 = library.textSecondary
            label.TextSize = 13.000
            label.TextWrapped = true
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.RichText = true

            labelPadding.Name = "pagePadding"
            labelPadding.Parent = label
            labelPadding.PaddingBottom = UDim.new(0, 2)
            labelPadding.PaddingLeft = UDim.new(0, 2)
            labelPadding.PaddingRight = UDim.new(0, 2)
            labelPadding.PaddingTop = UDim.new(0, 2)

            if alignment:lower():find("le") then
                label.TextXAlignment = Enum.TextXAlignment.Left
            elseif alignment:lower():find("cent") then
                label.TextXAlignment = Enum.TextXAlignment.Center
            elseif alignment:lower():find("ri") then
                label.TextXAlignment = Enum.TextXAlignment.Right
            end

            UpdatePageSize()

            local LabelFunctions = {}
            function LabelFunctions:Text(text)
                text = text or "new label text"
                label.Text = text
                return LabelFunctions
            end
            --
            function LabelFunctions:Remove()
                label:Destroy()
                return LabelFunctions
            end
            --
            function LabelFunctions:Hide()
                label.Visible = false
                UpdatePageSize()
                return LabelFunctions
            end
            --
            function LabelFunctions:Show()
                label.Visible = true
                UpdatePageSize()
                return LabelFunctions
            end
            --
            function LabelFunctions:Align(new)
                new = new or "le"
                if new:lower():find("le") then
                    label.TextXAlignment = Enum.TextXAlignment.Left
                elseif new:lower():find("cent") then
                    label.TextXAlignment = Enum.TextXAlignment.Center
                elseif new:lower():find("ri") then
                    label.TextXAlignment = Enum.TextXAlignment.Right
                end
            end
            return LabelFunctions
        end

        function Components:NewButton(text, callback)
            self._lastComponentType = "other"
            self._lastToggleRecord = nil
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            text = text or "button"
            callback = callback or function() end

            local buttonFrame = Instance.new("Frame")
            local buttonLayout = Instance.new("UIListLayout")
            local button = Instance.new("TextButton")
            local buttonCorner = Instance.new("UICorner")
            local buttonBackground = Instance.new("Frame")
            local buttonGradient = Instance.new("UIGradient")
            local buttonBackCorner = Instance.new("UICorner")
            local buttonLabel = Instance.new("TextLabel")

            buttonFrame.Name = "buttonFrame"
            buttonFrame.Parent = page
            buttonFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            buttonFrame.BackgroundTransparency = 1.000
            buttonFrame.Size = UDim2.new(0, _w, 0, 32)

            -- v2.6: old scripts often create a full-width button whose text is
            -- identical to the group/module heading (e.g. MOB ESP -> Mob ESP).
            -- It is purely redundant in the new card design, so collapse only
            -- that exact duplicate while leaving real action buttons untouched.
            local function _cleanComponentName(v)
                return tostring(v or ""):lower():gsub("[^%w]", "")
            end
            local duplicateGroupButton = self._groupTitle ~= nil
                and _cleanComponentName(text) == _cleanComponentName(self._groupTitle)
            if duplicateGroupButton then
                buttonFrame.Visible = false
                buttonFrame.Size = UDim2.new(0, _w, 0, 0)
            end

            buttonLayout.Name = "buttonLayout"
            buttonLayout.Parent = buttonFrame
            buttonLayout.FillDirection = Enum.FillDirection.Horizontal
            buttonLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            buttonLayout.SortOrder = Enum.SortOrder.LayoutOrder
            buttonLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            buttonLayout.Padding = UDim.new(0, 4)

            button.Name = "button"
            button.Parent = buttonFrame
            button.BackgroundColor3 = library.accentSoft
            button.Size = UDim2.new(0, _w, 0, 32)
            button.AutoButtonColor = false
            button.Font = Enum.Font.SourceSans
            button.Text = ""
            button.TextColor3 = Color3.fromRGB(0, 0, 0)
            button.TextSize = 14.000

            buttonCorner.CornerRadius = UDim.new(0, 7)
            buttonCorner.Name = "buttonCorner"
            buttonCorner.Parent = button

            buttonBackground.Name = "buttonBackground"
            buttonBackground.Parent = button
            buttonBackground.AnchorPoint = Vector2.new(0.5, 0.5)
            buttonBackground.BackgroundColor3 = Color3.fromRGB(22, 18, 34)
            buttonBackground.Position = UDim2.new(0.5, 0, 0.5, 0)
            buttonBackground.Size = UDim2.new(0, _w - 2, 0, 30)

            buttonGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(34, 25, 52)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(23, 19, 35))}
            buttonGradient.Rotation = 90
            buttonGradient.Name = "buttonGradient"
            buttonGradient.Parent = buttonBackground

            buttonBackCorner.CornerRadius = UDim.new(0, 6)
            buttonBackCorner.Name = "buttonBackCorner"
            buttonBackCorner.Parent = buttonBackground

            buttonLabel.Name = "buttonLabel"
            buttonLabel.Parent = buttonBackground
            buttonLabel.AnchorPoint = Vector2.new(0.5, 0.5)
            buttonLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            buttonLabel.BackgroundTransparency = 1.000
            buttonLabel.ClipsDescendants = true
            buttonLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
            buttonLabel.Size = UDim2.new(0, _w - 2, 0, 30)
            buttonLabel.Font = Enum.Font.GothamMedium
            buttonLabel.Text = text
            buttonLabel.TextColor3 = library.accentColor
            buttonLabel.TextSize = 12.000
            buttonLabel.RichText = true

            button.MouseEnter:Connect(function()
                TweenService:Create(button, TweenTable["hover"], {BackgroundColor3 = library.accentColor}):Play()
            end)
            button.MouseLeave:Connect(function()
                TweenService:Create(button, TweenTable["hover"], {BackgroundColor3 = library.accentSoft}):Play()
            end)

            button.MouseButton1Down:Connect(function()
                TweenService:Create(buttonLabel, TweenTable["hover"], {TextColor3 = library.textPrimary}):Play()
            end)
            button.MouseButton1Up:Connect(function()
                TweenService:Create(buttonLabel, TweenTable["hover"], {TextColor3 = library.accentColor}):Play()
            end)

            button.MouseButton1Click:Connect(function()
                if not page.Visible then return end
                callback()
            end)

            local NewSizeX = _w
            local Amnt = 0
            local function ResizeButtons()
                local Amount = buttonFrame:GetChildren()
                local Resized = _w
                Amount = #Amount - 1
                Amnt = Amount
                local AmountToSubtract = (Amount / 2)
                Resized = (_w / Amount) - AmountToSubtract
                NewSizeX = (Resized)

                for i,v in pairs(buttonFrame:GetChildren()) do
                    if v:IsA("TextButton") then
                        v.Size = UDim2.new(0, Resized, 0, 32)
                        for z,x in pairs(v:GetDescendants()) do
                            if x:IsA("TextLabel") or x:IsA("Frame") then
                                x.Size = UDim2.new(0, Resized - 2, 0, 30)
                            end
                        end
                    end
                end
            end

            buttonFrame.ChildAdded:Connect(ResizeButtons)
            buttonFrame.ChildRemoved:Connect(ResizeButtons)

            UpdatePageSize()

            --
            local ButtonFunctions = {}
            function ButtonFunctions:AddButton(text, callback_2)
                if Amnt < 4 then
                    text = text or "button"
                    callback_2 = callback_2 or function() end
    
                    local button = Instance.new("TextButton")
                    local buttonCorner = Instance.new("UICorner")
                    local buttonBackground = Instance.new("Frame")
                    local buttonGradient = Instance.new("UIGradient")
                    local buttonBackCorner = Instance.new("UICorner")
                    local buttonLabel = Instance.new("TextLabel")
        
                    button.Name = "button"
                    button.Parent = buttonFrame
                    button.BackgroundColor3 = library.accentSoft
                    button.Size = UDim2.new(0, NewSizeX - Amnt, 0, 32)
                    button.AutoButtonColor = false
                    button.Font = Enum.Font.SourceSans
                    button.Text = ""
                    button.TextColor3 = Color3.fromRGB(0, 0, 0)
                    button.TextSize = 14.000
        
                    buttonCorner.CornerRadius = UDim.new(0, 7)
                    buttonCorner.Name = "buttonCorner"
                    buttonCorner.Parent = button
        
                    buttonBackground.Name = "buttonBackground"
                    buttonBackground.Parent = button
                    buttonBackground.AnchorPoint = Vector2.new(0.5, 0.5)
                    buttonBackground.BackgroundColor3 = Color3.fromRGB(22, 18, 34)
                    buttonBackground.Position = UDim2.new(0.5, 0, 0.5, 0)
                    buttonBackground.Size = UDim2.new(0, (NewSizeX - 2) - Amnt, 0, 22)
        
                    buttonGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(34, 25, 52)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(23, 19, 35))}
                    buttonGradient.Rotation = 90
                    buttonGradient.Name = "buttonGradient"
                    buttonGradient.Parent = buttonBackground
        
                    buttonBackCorner.CornerRadius = UDim.new(0, 6)
                    buttonBackCorner.Name = "buttonBackCorner"
                    buttonBackCorner.Parent = buttonBackground
        
                    buttonLabel.Name = "buttonLabel"
                    buttonLabel.Parent = buttonBackground
                    buttonLabel.AnchorPoint = Vector2.new(0.5, 0.5)
                    buttonLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    buttonLabel.BackgroundTransparency = 1.000
                    buttonLabel.ClipsDescendants = true
                    buttonLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
                    buttonLabel.Size = UDim2.new(0, NewSizeX - 2, 0, 22)
                    buttonLabel.Font = Enum.Font.GothamMedium
                    buttonLabel.Text = text
                    buttonLabel.TextColor3 = library.accentColor
                    buttonLabel.TextSize = 12.000
                    buttonLabel.RichText = true

                    UpdatePageSize()
        
                    button.MouseEnter:Connect(function()
                        TweenService:Create(button, TweenTable["hover"], {BackgroundColor3 = library.accentColor}):Play()
                    end)
                    button.MouseLeave:Connect(function()
                        TweenService:Create(button, TweenTable["hover"], {BackgroundColor3 = library.accentSoft}):Play()
                    end)
        
                    button.MouseButton1Down:Connect(function()
                        TweenService:Create(buttonLabel, TweenTable["hover"], {TextColor3 = library.textPrimary}):Play()
                    end)
                    button.MouseButton1Up:Connect(function()
                        TweenService:Create(buttonLabel, TweenTable["hover"], {TextColor3 = library.accentColor}):Play()
                    end)
        
                    button.MouseButton1Click:Connect(function()
                        callback_2()
                    end)

                    local ButtonFunctions2 = {}
                    function ButtonFunctions2:Fire()
                        callback_2()

                        return ButtonFunctions2
                    end
                    --
                    function ButtonFunctions2:Hide()
                        button.Visible = false

                        return ButtonFunctions2
                    end
                    --
                    function ButtonFunctions2:Show()
                        button.Visible = true

                        return ButtonFunctions2
                    end
                    --
                    function ButtonFunctions2:Text(text)
                        text = text or "button new text"
                        buttonLabel.Text = text

                        return ButtonFunctions2
                    end
                    --
                    function ButtonFunctions2:Remove()
                        button:Destroy()

                        return ButtonFunctions2
                    end
                    --
                    function ButtonFunctions2:SetFunction(new)
                        new = new or function() end
                        callback_2 = new

                        return ButtonFunctions2
                    end
                    return ButtonFunctions2 and ButtonFunctions
                elseif Amnt > 4 then
                    print("more than 4 buttons are not supported.")
                end
                return ButtonFunctions
            end
            --
            function ButtonFunctions:Fire()
                callback()

                return ButtonFunctions
            end
            --
            function ButtonFunctions:Hide()
                button.Visible = false

                return ButtonFunctions
            end
            --
            function ButtonFunctions:Show()
                button.Visible = true

                return ButtonFunctions
            end
            --
            function ButtonFunctions:Text(text)
                text = text or "button new text"
                buttonLabel.Text = text

                return ButtonFunctions
            end
            --
            function ButtonFunctions:Remove()
                button:Destroy()

                return ButtonFunctions
            end
            --
            function ButtonFunctions:SetFunction(new)
                new = new or function() end
                callback = new

                return ButtonFunctions
            end
            return ButtonFunctions
        end
        --

        function Components:NewSection(text)
            self._lastComponentType = "other"
            self._lastToggleRecord = nil
            local page = self._page
            local _w = self._width
            local UpdatePageSize = self._updateSize
            text = text or "section"

            local sectionFrame = Instance.new("Frame")
            local sectionLayout = Instance.new("UIListLayout")
            local leftBar = Instance.new("Frame")
            local sectionLabel = Instance.new("TextLabel")
            local sectionPadding = Instance.new("UIPadding")
            local rightBar = Instance.new("Frame")

            sectionFrame.Name = "sectionFrame"
            sectionFrame.Parent = page
            sectionFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sectionFrame.BackgroundTransparency = 1.000
            sectionFrame.ClipsDescendants = true
            sectionFrame.Size = UDim2.new(0, _w, 0, 24)

            sectionLayout.Name = "sectionLayout"
            sectionLayout.Parent = sectionFrame
            sectionLayout.FillDirection = Enum.FillDirection.Horizontal
            sectionLayout.SortOrder = Enum.SortOrder.LayoutOrder
            sectionLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            sectionLayout.Padding = UDim.new(0, 4)


            sectionLabel.Name = "sectionLabel"
            sectionLabel.Parent = sectionFrame
            sectionLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sectionLabel.BackgroundTransparency = 1.000
            sectionLabel.ClipsDescendants = true
            sectionLabel.Position = UDim2.new(0.0252525248, 0, 0.020833334, 0)
            sectionLabel.Size = UDim2.new(0, 0, 0, 24)
            sectionLabel.Font = Enum.Font.GothamSemibold
            sectionLabel.LineHeight = 1
            sectionLabel.Text = string.upper(text)
            sectionLabel.TextColor3 = library.accentColor
            sectionLabel.TextSize = 10.000
            sectionLabel.TextXAlignment = Enum.TextXAlignment.Left
            sectionLabel.RichText = true

            sectionPadding.Name = "sectionPadding"
            sectionPadding.Parent = sectionLabel
            sectionPadding.PaddingBottom = UDim.new(0, 6)
            sectionPadding.PaddingLeft = UDim.new(0, 0)
            sectionPadding.PaddingRight = UDim.new(0, 6)
            sectionPadding.PaddingTop = UDim.new(0, 6)

            rightBar.Name = "rightBar"
            rightBar.Parent = sectionFrame
            rightBar.BackgroundColor3 = library.strokeColor
            rightBar.BorderSizePixel = 0
            rightBar.Position = UDim2.new(0.308080822, 0, 0.479166657, 0)
            rightBar.Size = UDim2.new(1, 0, 0, 1)
            UpdatePageSize()

            local NewSectionSize = TextService:GetTextSize(sectionLabel.Text, sectionLabel.TextSize, sectionLabel.Font, Vector2.new(math.huge,math.huge))
            sectionLabel.Size = UDim2.new(0, NewSectionSize.X, 0, 18)

            local SectionFunctions = {}
            function SectionFunctions:Text(new)
                new = new or text
                sectionLabel.Text = string.upper(new)

                local NewSectionSize = TextService:GetTextSize(sectionLabel.Text, sectionLabel.TextSize, sectionLabel.Font, Vector2.new(math.huge,math.huge))
                sectionLabel.Size = UDim2.new(0, NewSectionSize.X, 0, 18)

                return SectionFunctions
            end
            function SectionFunctions:Hide()
                sectionFrame.Visible = false
                return SectionFunctions
            end
            function SectionFunctions:Show()
                sectionFrame.Visible = true
                return SectionFunctions
            end
            function SectionFunctions:Remove()
                sectionFrame:Destroy()
                return SectionFunctions
            end
            --
            return SectionFunctions
        end

