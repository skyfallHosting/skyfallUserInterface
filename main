    text.Parent = background
    text.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    text.BackgroundTransparency = 1.000
    text.Position = UDim2.new(0.912751675, 0, 0, 0)
    text.Size = UDim2.new(0, 26, 0, 21)
    text.Font = Enum.Font.Code
    text.Text = "hash"
    text.TextColor3 = Color3.fromRGB(124, 124, 124)
    text.TextSize = 10.000
    text.TextTransparency = 1
    text.RichText = true
    
    pageLayout.Name = "pageLayout"
    pageLayout.Parent = introduction
    pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.VerticalAlignment = Enum.VerticalAlignment.Center

    CreateTween("xsxRotation", 0)
    local MinusAmount = -16
    coroutine.wrap(function()
        while wait() do
            MinusAmount = MinusAmount + 0.4
            TweenService:Create(xsxLogo, TweenTable["xsxRotation"], {Rotation = xsxLogo.Rotation - MinusAmount}):Play()
        end
    end)()

    TweenService:Create(edge, TweenTable["introduction"], {BackgroundTransparency = 0}):Play()
    TweenService:Create(background, TweenTable["introduction"], {BackgroundTransparency = 0}):Play()
    wait(.2)
    TweenService:Create(bar, TweenTable["introduction"], {Size = UDim2.new(0, 298, 0, 1)}):Play()
    wait(.2)
    TweenService:Create(xsx, TweenTable["introduction"], {TextTransparency = 0}):Play()
    TweenService:Create(text, TweenTable["introduction"], {TextTransparency = 0}):Play()
    wait(.3)
    TweenService:Create(xsxLogo, TweenTable["introduction"], {ImageTransparency = 0}):Play()
    wait(2)
    TweenService:Create(xsxLogo, TweenTable["introduction"], {ImageTransparency = 1}):Play()
    wait(.2)
    TweenService:Create(hashLogo, TweenTable["introduction"], {ImageTransparency = 0}):Play()
    wait(2)
    TweenService:Create(hashLogo, TweenTable["introduction"], {ImageTransparency = 1}):Play()
    wait(.1)
    TweenService:Create(text, TweenTable["introduction"], {TextTransparency = 1}):Play()
    wait(.1)
    TweenService:Create(xsx, TweenTable["introduction"], {TextTransparency = 1}):Play()
    wait(.1)
    TweenService:Create(bar, TweenTable["introduction"], {Size = UDim2.new(0, 0, 0, 1)}):Play()
    wait(.1)
    TweenService:Create(background, TweenTable["introduction"], {BackgroundTransparency = 1}):Play()
    TweenService:Create(edge, TweenTable["introduction"], {BackgroundTransparency = 1}):Play()
    wait(.2)
    introduction:Destroy()
end

function library:Init(key)
    for _,v in next, CoreGuiService:GetChildren() do
        if v.Name == "screen" then
            v:Destroy()
        end
    end

    local title = library.title
    key = key or Enum.KeyCode.RightAlt

    library:InitAtmosphereAssets()

    local productTitle = tostring(title or "Skyfall Hub")
    local parsed = productTitle:match("—%s*(.+)$") or productTitle:match("%-%s*(.+)$")
    if parsed and parsed ~= "" then
        productTitle = parsed
    elseif productTitle:lower():find("skyfall hub", 1, true) then
        productTitle = productTitle:gsub("^[Ss][Kk][Yy][Ff][Aa][Ll][Ll]%s+[Hh][Uu][Bb]%s*", "")
    end
    if productTitle == "" then productTitle = "Skyfall Hub" end

    if not library.icon then
        library.icon = library:LoadIcon("https://raw.githubusercontent.com/skyfallHosting/skyfallUserInterface/main/icon.png", "skyfall_icon.png")
    end

    local screen = Instance.new("ScreenGui")
    local edge = Instance.new("Frame")
    local edgeCorner = Instance.new("UICorner")
    local background = Instance.new("Frame")
    local backgroundCorner = Instance.new("UICorner")
    local backgroundGradient = Instance.new("UIGradient")
    local headerLabel = Instance.new("TextLabel")
    local headerPadding = Instance.new("UIPadding")
    local barFolder = Instance.new("Folder")
    local bar = Instance.new("Frame")
    local barCorner = Instance.new("UICorner")
    local barLayout = Instance.new("UIListLayout")
    local tabButtonsEdge = Instance.new("Frame")
    local tabButtonCorner = Instance.new("UICorner")
    local tabButtons = Instance.new("Frame")
    local tabButtonCorner_2 = Instance.new("UICorner")
    local tabButtonsGradient = Instance.new("UIGradient")
    local tabButtonLayout = Instance.new("UIListLayout")
    local tabButtonPadding = Instance.new("UIPadding")
    local containerEdge = Instance.new("Frame")
    local tabButtonCorner_3 = Instance.new("UICorner")
    local container = Instance.new("Frame")
    local containerCorner = Instance.new("UICorner")
    local containerGradient = Instance.new("UIGradient")

    screen.Name = "screen"
    screen.Parent = CoreGuiService
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.DisplayOrder = 999
    table.insert(library._screenGuis, screen)

    edge.Name = "edge"
    edge.Parent = screen
    edge.AnchorPoint = Vector2.new(0.5, 0.5)
    edge.BackgroundColor3 = Color3.fromRGB(30, 24, 44)
    edge.Position = UDim2.new(0.5, 0, 0.5, 0)
    edge.Size = UDim2.new(0, 840, 0, 540)
    edge.BorderSizePixel = 0
    edge.ClipsDescendants = false
    edge.ZIndex = 2

    -- Window halo: one blurred texture + two extremely soft strokes.
    local windowGlow = library:AddSoftGlow(edge, 0.72, 34, library.accentColor, 0)
    local windowStroke = Instance.new("UIStroke")
    windowStroke.Name = "windowAccentStroke"
    windowStroke.Parent = edge
    windowStroke.Color = library.accentColor
    windowStroke.Transparency = 0.54
    windowStroke.Thickness = 1

    local windowGlowStroke = Instance.new("UIStroke")
    windowGlowStroke.Name = "windowGlowStroke"
    windowGlowStroke.Parent = edge
    windowGlowStroke.Color = library.accentColor
    windowGlowStroke.Transparency = 0.87
    windowGlowStroke.Thickness = 4

    drag(edge, 0.04)

    local menuScale = Instance.new("UIScale")
    local baseMenuScale = 1
    if not isMobile and workspace.CurrentCamera then
        local viewport = workspace.CurrentCamera.ViewportSize
        baseMenuScale = math.min(1, math.max(0.72, math.min((viewport.X - 22) / 840, (viewport.Y - 22) / 540)))
    end
    menuScale.Scale = baseMenuScale
    menuScale.Parent = edge

    local menuVisible = true
    local menuAnimating = false
    CreateTween("menu_show", 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    CreateTween("menu_hide", 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    local function toggleMenu()
        if menuAnimating then return end
        menuAnimating = true
        if menuVisible then
            if library._closeActivePopup then
                library._closeActivePopup()
            end
            local tw = TweenService:Create(menuScale, TweenTable["menu_hide"], {Scale = baseMenuScale * 0.92})
            tw:Play()
            tw.Completed:Connect(function()
                edge.Visible = false
                menuVisible = false
                menuAnimating = false
            end)
        else
            menuScale.Scale = baseMenuScale * 0.92
            edge.Visible = true
            local tw = TweenService:Create(menuScale, TweenTable["menu_show"], {Scale = baseMenuScale})
            tw:Play()
            tw.Completed:Connect(function()
                menuVisible = true
                menuAnimating = false
            end)
        end
    end

    local CanChangeVisibility = true
    table.insert(library._connections, UserInputService.InputBegan:Connect(function(input)
        if CanChangeVisibility and input.KeyCode == key then
            toggleMenu()
        end
    end))

    if isMobile then
        local viewport = workspace.CurrentCamera.ViewportSize
        local scaleFactor = viewport.X < 700 and 1.5 or 1.25
        local mobileScale = Instance.new("UIScale")
        mobileScale.Scale = scaleFactor
        mobileScale.Parent = edge

        local menuBtn = Instance.new("TextButton")
        menuBtn.Name = "MobileMenuToggle"
        menuBtn.Text = "="
        menuBtn.Font = Enum.Font.GothamBold
        menuBtn.TextSize = 22
        menuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        menuBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        menuBtn.BackgroundTransparency = 0.25
        menuBtn.Size = UDim2.new(0, 46, 0, 46)
        menuBtn.Position = UDim2.new(0, 12, 0.5, -23)
        menuBtn.ZIndex = 9999
        menuBtn.AutoButtonColor = false
        menuBtn.Active = true
        menuBtn.BorderSizePixel = 0
        menuBtn.Parent = screen
        pcall(function() Instance.new("UICorner", menuBtn).CornerRadius = UDim.new(0, 10) end)
        pcall(function()
            local s = Instance.new("UIStroke")
            s.Color = Color3.fromRGB(80, 80, 80)
            s.Thickness = 1
            s.Parent = menuBtn
        end)
        local btnDragStart, btnStartPos, btnWasDragged
        menuBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                btnDragStart = inp.Position
                btnStartPos = menuBtn.Position
                btnWasDragged = false
            end
        end)
        table.insert(library._connections, UserInputService.InputChanged:Connect(function(inp)
            if btnDragStart and (inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseMovement) then
                local delta = inp.Position - btnDragStart
                if delta.Magnitude > 10 then
                    btnWasDragged = true
                    menuBtn.Position = UDim2.new(btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X, btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y)
                end
            end
        end))
        table.insert(library._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if btnDragStart and not btnWasDragged then
                    toggleMenu()
                end
                btnDragStart = nil
                btnWasDragged = false
            end
        end))
    end

    edgeCorner.CornerRadius = UDim.new(0, 16)
    edgeCorner.Name = "edgeCorner"
    edgeCorner.Parent = edge

    background.Name = "background"
    background.Parent = edge
    background.AnchorPoint = Vector2.new(0.5, 0.5)
    background.BackgroundColor3 = library.bgColor
    background.Position = UDim2.new(0.5, 0, 0.5, 0)
    background.Size = UDim2.new(0, 838, 0, 538)
    background.ClipsDescendants = true
    background.BorderSizePixel = 0
    background.ZIndex = 2

    backgroundCorner.CornerRadius = UDim.new(0, 15)
    backgroundCorner.Name = "backgroundCorner"
    backgroundCorner.Parent = background

    local innerWindowStroke = Instance.new("UIStroke")
    innerWindowStroke.Name = "windowStroke"
    innerWindowStroke.Parent = background
    innerWindowStroke.Color = Color3.fromRGB(75, 63, 105)
    innerWindowStroke.Transparency = 0.66
    innerWindowStroke.Thickness = 1

    backgroundGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(15, 16, 23)),
        ColorSequenceKeypoint.new(0.48, Color3.fromRGB(10, 11, 17)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(8, 9, 14))
    }
    backgroundGradient.Rotation = 112
    backgroundGradient.Name = "backgroundGradient"
    backgroundGradient.Parent = background

    -- Large ambient light pools keep the shell from feeling flat.
    if library.glowAsset then
        local ambientTop = Instance.new("ImageLabel")
        ambientTop.Name = "ambientTop"
        ambientTop.Parent = background
        ambientTop.BackgroundTransparency = 1
        ambientTop.Image = library.glowAsset
        ambientTop.ImageColor3 = library.accentColor
        ambientTop.ImageTransparency = 0.845
        ambientTop.ScaleType = Enum.ScaleType.Stretch
        ambientTop.Position = UDim2.new(0.28, 0, 0, -170)
        ambientTop.Size = UDim2.new(0, 590, 0, 410)
        ambientTop.ZIndex = 3
        ambientTop.Active = false

        local ambientSide = Instance.new("ImageLabel")
        ambientSide.Name = "ambientSide"
        ambientSide.Parent = background
        ambientSide.BackgroundTransparency = 1
        ambientSide.Image = library.glowAsset
        ambientSide.ImageColor3 = Color3.fromRGB(86, 61, 148)
        ambientSide.ImageTransparency = 0.895
